{
  "operationId": "post_nodes_node_storage_storage_content",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "create",
  "method": "POST",
  "path": "/nodes/{node}/storage/{storage}/content",
  "description": "Allocate disk images.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "storage",
      "type": "string",
      "required": true,
      "description": "The storage identifier.",
      "format": "pve-storage-id",
      "typetext": "<storage ID>"
    }
  ],
  "params": [
    {
      "name": "filename",
      "type": "string",
      "required": true,
      "description": "The name of the file to create.",
      "typetext": "<string>"
    },
    {
      "name": "format",
      "type": "string",
      "required": false,
      "description": "Format of the image.",
      "enum": [
        "raw",
        "qcow2",
        "subvol",
        "vmdk"
      ]
    },
    {
      "name": "size",
      "type": "string",
      "required": true,
      "description": "Size in kilobyte (1024 bytes). Optional suffixes 'M' (megabyte, 1024K) and 'G' (gigabyte, 1024M)",
      "pattern": "\\d+[MG]?"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "Specify owner VM",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "returns": {
    "description": "Volume identifier",
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/storage/{storage}",
      [
        "Datastore.AllocateSpace"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"filename\":\"<filename>\",\"size\":\"<size>\",\"vmid\":\"100\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/storage/<storage>/content'"
}

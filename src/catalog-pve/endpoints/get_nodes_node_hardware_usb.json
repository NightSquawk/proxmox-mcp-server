{
  "operationId": "get_nodes_node_hardware_usb",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "usbscan",
  "method": "GET",
  "path": "/nodes/{node}/hardware/usb",
  "description": "List local USB devices.",
  "writeOperation": false,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [],
  "returns": {
    "items": {
      "properties": {
        "busnum": {
          "type": "integer"
        },
        "class": {
          "type": "integer"
        },
        "devnum": {
          "type": "integer"
        },
        "level": {
          "type": "integer"
        },
        "manufacturer": {
          "optional": 1,
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "prodid": {
          "type": "string"
        },
        "product": {
          "optional": 1,
          "type": "string"
        },
        "serial": {
          "optional": 1,
          "type": "string"
        },
        "speed": {
          "type": "string"
        },
        "usbpath": {
          "optional": 1,
          "type": "string"
        },
        "vendid": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/hardware/usb'"
}

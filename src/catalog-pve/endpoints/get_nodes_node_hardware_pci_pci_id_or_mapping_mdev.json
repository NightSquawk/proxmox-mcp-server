{
  "operationId": "get_nodes_node_hardware_pci_pci_id_or_mapping_mdev",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "mdevscan",
  "method": "GET",
  "path": "/nodes/{node}/hardware/pci/{pci-id-or-mapping}/mdev",
  "description": "List mediated device types for given PCI device.",
  "writeOperation": false,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "pci-id-or-mapping",
      "type": "string",
      "required": true,
      "description": "The PCI ID or mapping to list the mdev types for.",
      "pattern": "(?:(?:[0-9a-fA-F]{4}:)?[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\\.[0-9a-fA-F])|([a-zA-Z][a-zA-Z0-9_-]+)"
    }
  ],
  "params": [],
  "returns": {
    "items": {
      "properties": {
        "available": {
          "description": "The number of still available instances of this type.",
          "type": "integer"
        },
        "description": {
          "description": "Additional description of the type.",
          "type": "string"
        },
        "name": {
          "description": "A human readable name for the type.",
          "optional": 1,
          "type": "string"
        },
        "type": {
          "description": "The name of the mdev type.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Audit",
        "Sys.Modify"
      ],
      "any",
      1
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/hardware/pci/<pci-id-or-mapping>/mdev'"
}

{
  "operationId": "put_access_users_userid_unlock_tfa",
  "surface": "pve",
  "resource": "access",
  "category": "Access & Auth",
  "name": "unlock_tfa",
  "method": "PUT",
  "path": "/access/users/{userid}/unlock-tfa",
  "description": "Unlock a user's TFA authentication.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "userid",
      "type": "string",
      "required": true,
      "description": "Full User ID, in the `name@realm` format.",
      "format": "pve-userid",
      "maxLength": 64,
      "typetext": "<string>"
    }
  ],
  "params": [],
  "returns": {
    "type": "boolean"
  },
  "permissions": {
    "check": [
      "userid-group",
      [
        "User.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/access/users/<userid>/unlock-tfa'"
}

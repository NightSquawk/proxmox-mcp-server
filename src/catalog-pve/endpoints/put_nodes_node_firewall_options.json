{
  "operationId": "put_nodes_node_firewall_options",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "set_options",
  "method": "PUT",
  "path": "/nodes/{node}/firewall/options",
  "description": "Set Firewall options.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "delete",
      "type": "string",
      "required": false,
      "description": "A list of settings you want to delete.",
      "format": "pve-configid-list",
      "typetext": "<string>"
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has a different digest. This can be used to prevent concurrent modifications.",
      "maxLength": 64,
      "typetext": "<string>"
    },
    {
      "name": "enable",
      "type": "boolean",
      "required": false,
      "description": "Enable host firewall rules.",
      "default": 1,
      "typetext": "<boolean>"
    },
    {
      "name": "log_level_forward",
      "type": "string",
      "required": false,
      "description": "Log level for forwarded traffic.",
      "enum": [
        "emerg",
        "alert",
        "crit",
        "err",
        "warning",
        "notice",
        "info",
        "debug",
        "nolog"
      ]
    },
    {
      "name": "log_level_in",
      "type": "string",
      "required": false,
      "description": "Log level for incoming traffic.",
      "enum": [
        "emerg",
        "alert",
        "crit",
        "err",
        "warning",
        "notice",
        "info",
        "debug",
        "nolog"
      ]
    },
    {
      "name": "log_level_out",
      "type": "string",
      "required": false,
      "description": "Log level for outgoing traffic.",
      "enum": [
        "emerg",
        "alert",
        "crit",
        "err",
        "warning",
        "notice",
        "info",
        "debug",
        "nolog"
      ]
    },
    {
      "name": "log_nf_conntrack",
      "type": "boolean",
      "required": false,
      "description": "Enable logging of conntrack information.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "ndp",
      "type": "boolean",
      "required": false,
      "description": "Enable NDP (Neighbor Discovery Protocol).",
      "default": 1,
      "typetext": "<boolean>"
    },
    {
      "name": "nf_conntrack_allow_invalid",
      "type": "boolean",
      "required": false,
      "description": "Allow invalid packets on connection tracking.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "nf_conntrack_helpers",
      "type": "string",
      "required": false,
      "description": "Enable conntrack helpers for specific protocols. Supported protocols: amanda, ftp, irc, netbios-ns, pptp, sane, sip, snmp, tftp",
      "format": "pve-fw-conntrack-helper",
      "default": "",
      "typetext": "<string>"
    },
    {
      "name": "nf_conntrack_max",
      "type": "integer",
      "required": false,
      "description": "Maximum number of tracked connections.",
      "default": 262144,
      "minimum": 32768,
      "typetext": "<integer> (32768 - N)"
    },
    {
      "name": "nf_conntrack_tcp_timeout_established",
      "type": "integer",
      "required": false,
      "description": "Conntrack established timeout.",
      "default": 432000,
      "minimum": 7875,
      "typetext": "<integer> (7875 - N)"
    },
    {
      "name": "nf_conntrack_tcp_timeout_syn_recv",
      "type": "integer",
      "required": false,
      "description": "Conntrack syn recv timeout.",
      "default": 60,
      "minimum": 30,
      "maximum": 60,
      "typetext": "<integer> (30 - 60)"
    },
    {
      "name": "nftables",
      "type": "boolean",
      "required": false,
      "description": "Enable nftables based firewall (tech preview)",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "nosmurfs",
      "type": "boolean",
      "required": false,
      "description": "Enable SMURFS filter.",
      "typetext": "<boolean>"
    },
    {
      "name": "protection_synflood",
      "type": "boolean",
      "required": false,
      "description": "Enable synflood protection",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "protection_synflood_burst",
      "type": "integer",
      "required": false,
      "description": "Synflood protection rate burst by ip src.",
      "default": 1000,
      "typetext": "<integer>"
    },
    {
      "name": "protection_synflood_rate",
      "type": "integer",
      "required": false,
      "description": "Synflood protection rate syn/sec by ip src.",
      "default": 200,
      "typetext": "<integer>"
    },
    {
      "name": "smurf_log_level",
      "type": "string",
      "required": false,
      "description": "Log level for SMURFS filter.",
      "enum": [
        "emerg",
        "alert",
        "crit",
        "err",
        "warning",
        "notice",
        "info",
        "debug",
        "nolog"
      ]
    },
    {
      "name": "tcp_flags_log_level",
      "type": "string",
      "required": false,
      "description": "Log level for illegal tcp flags filter.",
      "enum": [
        "emerg",
        "alert",
        "crit",
        "err",
        "warning",
        "notice",
        "info",
        "debug",
        "nolog"
      ]
    },
    {
      "name": "tcpflags",
      "type": "boolean",
      "required": false,
      "description": "Filter illegal combinations of TCP flags.",
      "default": 0,
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/firewall/options'"
}

{
  "operationId": "get_nodes_node_storage_storage_rrd",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "rrd",
  "method": "GET",
  "path": "/nodes/{node}/storage/{storage}/rrd",
  "description": "Read storage RRD statistics (returns PNG).",
  "writeOperation": false,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "storage",
      "type": "string",
      "required": true,
      "description": "The storage identifier.",
      "format": "pve-storage-id",
      "typetext": "<storage ID>"
    }
  ],
  "params": [
    {
      "name": "cf",
      "type": "string",
      "required": false,
      "description": "The RRD consolidation function",
      "enum": [
        "AVERAGE",
        "MAX"
      ]
    },
    {
      "name": "ds",
      "type": "string",
      "required": true,
      "description": "The list of datasources you want to display.",
      "format": "pve-configid-list",
      "typetext": "<string>"
    },
    {
      "name": "timeframe",
      "type": "string",
      "required": true,
      "description": "Specify the time frame you are interested in.",
      "enum": [
        "hour",
        "day",
        "week",
        "month",
        "year"
      ]
    }
  ],
  "returns": {
    "properties": {
      "filename": {
        "type": "string"
      }
    },
    "type": "object"
  },
  "permissions": {
    "check": [
      "perm",
      "/storage/{storage}",
      [
        "Datastore.Audit",
        "Datastore.AllocateSpace"
      ],
      "any",
      1
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/storage/<storage>/rrd?ds=<ds>&timeframe=hour'"
}

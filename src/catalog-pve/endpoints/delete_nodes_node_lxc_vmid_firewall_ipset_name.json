{
  "operationId": "delete_nodes_node_lxc_vmid_firewall_ipset_name",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "delete_ipset",
  "method": "DELETE",
  "path": "/nodes/{node}/lxc/{vmid}/firewall/ipset/{name}",
  "description": "Delete IPSet",
  "writeOperation": true,
  "destructive": true,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    },
    {
      "name": "name",
      "type": "string",
      "required": true,
      "description": "IP set name.",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "[A-Za-z][A-Za-z0-9\\-\\_]+"
    }
  ],
  "params": [
    {
      "name": "force",
      "type": "boolean",
      "required": false,
      "description": "Delete all members of the IPSet, if there are any.",
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.Config.Network"
      ]
    ]
  },
  "requestSample": "curl -k -X DELETE -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/lxc/100/firewall/ipset/<name>'"
}

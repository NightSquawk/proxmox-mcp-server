{
  "operationId": "post_nodes_node_replication_id_schedule_now",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "schedule_now",
  "method": "POST",
  "path": "/nodes/{node}/replication/{id}/schedule_now",
  "description": "Schedule replication job to start as soon as possible.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "Replication Job ID. The ID is composed of a Guest ID and a job number, separated by a hyphen, i.e. '<GUEST>-<JOBNUM>'.",
      "format": "pve-replication-job-id",
      "pattern": "[1-9][0-9]{2,8}-\\d{1,9}"
    }
  ],
  "params": [],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "description": "Requires the VM.Replicate permission on /vms/<vmid>.",
    "user": "all"
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/replication/<id>/schedule_now'"
}

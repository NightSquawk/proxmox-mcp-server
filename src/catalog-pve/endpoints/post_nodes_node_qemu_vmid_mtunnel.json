{
  "operationId": "post_nodes_node_qemu_vmid_mtunnel",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "mtunnel",
  "method": "POST",
  "path": "/nodes/{node}/qemu/{vmid}/mtunnel",
  "description": "Migration tunnel endpoint - only for internal use by VM migration.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [
    {
      "name": "bridges",
      "type": "string",
      "required": false,
      "description": "List of network bridges to check availability. Will be checked again for actually used bridges during migration.",
      "format": "pve-bridge-id-list",
      "typetext": "<string>"
    },
    {
      "name": "storages",
      "type": "string",
      "required": false,
      "description": "List of storages to check permission and availability. Will be checked again for all actually used storages during migration.",
      "format": "pve-storage-id-list",
      "typetext": "<string>"
    }
  ],
  "returns": {
    "additionalProperties": 0,
    "properties": {
      "socket": {
        "type": "string"
      },
      "ticket": {
        "type": "string"
      },
      "upid": {
        "type": "string"
      }
    }
  },
  "permissions": {
    "check": [
      "and",
      [
        "perm",
        "/vms/{vmid}",
        [
          "VM.Allocate"
        ]
      ],
      [
        "perm",
        "/",
        [
          "Sys.Incoming"
        ]
      ]
    ],
    "description": "You need 'VM.Allocate' permissions on '/vms/{vmid}' and Sys.Incoming on '/'. Further permission checks happen during the actual migration."
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/qemu/100/mtunnel'"
}

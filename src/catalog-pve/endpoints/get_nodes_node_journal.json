{
  "operationId": "get_nodes_node_journal",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "journal",
  "method": "GET",
  "path": "/nodes/{node}/journal",
  "description": "Read Journal",
  "writeOperation": false,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "endcursor",
      "type": "string",
      "required": false,
      "description": "End before the given Cursor. Conflicts with 'until'",
      "typetext": "<string>"
    },
    {
      "name": "lastentries",
      "type": "integer",
      "required": false,
      "description": "Limit to the last X lines. Conflicts with a range.",
      "minimum": 0,
      "typetext": "<integer> (0 - N)"
    },
    {
      "name": "since",
      "type": "integer",
      "required": false,
      "description": "Display all log since this UNIX epoch. Conflicts with 'startcursor'.",
      "minimum": 0,
      "typetext": "<integer> (0 - N)"
    },
    {
      "name": "startcursor",
      "type": "string",
      "required": false,
      "description": "Start after the given Cursor. Conflicts with 'since'",
      "typetext": "<string>"
    },
    {
      "name": "until",
      "type": "integer",
      "required": false,
      "description": "Display all log until this UNIX epoch. Conflicts with 'endcursor'.",
      "minimum": 0,
      "typetext": "<integer> (0 - N)"
    }
  ],
  "returns": {
    "items": {
      "type": "string"
    },
    "type": "array"
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.Syslog"
      ]
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/journal'"
}

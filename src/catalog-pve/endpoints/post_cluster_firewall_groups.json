{
  "operationId": "post_cluster_firewall_groups",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "create_security_group",
  "method": "POST",
  "path": "/cluster/firewall/groups",
  "description": "Create new security group.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "comment",
      "type": "string",
      "required": false,
      "typetext": "<string>"
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has a different digest. This can be used to prevent concurrent modifications.",
      "maxLength": 64,
      "typetext": "<string>"
    },
    {
      "name": "group",
      "type": "string",
      "required": true,
      "description": "Security Group name.",
      "minLength": 2,
      "maxLength": 18,
      "pattern": "[A-Za-z][A-Za-z0-9\\-\\_]+"
    },
    {
      "name": "rename",
      "type": "string",
      "required": false,
      "description": "Rename/update an existing security group. You can set 'rename' to the same value as 'name' to update the 'comment' of an existing group.",
      "minLength": 2,
      "maxLength": 18,
      "pattern": "[A-Za-z][A-Za-z0-9\\-\\_]+"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"group\":\"<group>\"}' 'https://PVE_HOST:8006/api2/json/cluster/firewall/groups'"
}

{
  "operationId": "delete_cluster_replication_id",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "delete",
  "method": "DELETE",
  "path": "/cluster/replication/{id}",
  "description": "Mark replication job for removal.",
  "writeOperation": true,
  "destructive": true,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "Replication Job ID. The ID is composed of a Guest ID and a job number, separated by a hyphen, i.e. '<GUEST>-<JOBNUM>'.",
      "format": "pve-replication-job-id",
      "pattern": "[1-9][0-9]{2,8}-\\d{1,9}"
    }
  ],
  "params": [
    {
      "name": "force",
      "type": "boolean",
      "required": false,
      "description": "Will remove the jobconfig entry, but will not cleanup.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "keep",
      "type": "boolean",
      "required": false,
      "description": "Keep replicated data at target (do not remove).",
      "default": 0,
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "description": "Requires the VM.Replicate permission on /vms/<vmid>.",
    "user": "all"
  },
  "requestSample": "curl -k -X DELETE -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/cluster/replication/<id>'"
}

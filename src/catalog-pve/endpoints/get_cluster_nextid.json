  "paramLocation": "query",
  "pathParams": [],
  "params": [
    {
      "name": "vmid",
      "type": "integer",
      "required": false,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"

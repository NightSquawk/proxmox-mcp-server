{
  "operationId": "post_nodes_node_lxc_vmid_clone",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "clone_vm",
  "method": "POST",
  "path": "/nodes/{node}/lxc/{vmid}/clone",
  "description": "Create a container clone/copy",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [
    {
      "name": "bwlimit",
      "type": "number",
      "required": false,
      "description": "Override I/O bandwidth limit (in KiB/s).",
      "default": "clone limit from datacenter or storage config",
      "minimum": "0",
      "typetext": "<number> (0 - N)"
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "description": "Description for the new CT.",
      "typetext": "<string>"
    },
    {
      "name": "full",
      "type": "boolean",
      "required": false,
      "description": "Create a full copy of all disks. This is always done when you clone a normal CT. For CT templates, we try to create a linked clone by default.",
      "typetext": "<boolean>"
    },
    {
      "name": "hostname",
      "type": "string",
      "required": false,
      "description": "Set a hostname for the new CT.",
      "format": "dns-name",
      "typetext": "<string>"
    },
    {
      "name": "newid",
      "type": "integer",
      "required": true,
      "description": "VMID for the clone.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    },
    {
      "name": "pool",
      "type": "string",
      "required": false,
      "description": "Add the new CT to the specified pool.",
      "format": "pve-poolid",
      "typetext": "<string>"
    },
    {
      "name": "snapname",
      "type": "string",
      "required": false,
      "description": "The name of the snapshot.",
      "format": "pve-configid",
      "maxLength": 40,
      "typetext": "<string>"
    },
    {
      "name": "storage",
      "type": "string",
      "required": false,
      "description": "Target storage for full clone.",
      "format": "pve-storage-id",
      "typetext": "<storage ID>"
    },
    {
      "name": "target",
      "type": "string",
      "required": false,
      "description": "Target node. Only allowed if the original VM is on shared storage.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "and",
      [
        "perm",
        "/vms/{vmid}",
        [
          "VM.Clone"
        ]
      ],
      [
        "or",
        [
          "perm",
          "/vms/{newid}",
          [
            "VM.Allocate"
          ]
        ],
        [
          "perm",
          "/pool/{pool}",
          [
            "VM.Allocate"
          ],
          "require_param",
          "pool"
        ]
      ]
    ],
    "description": "You need 'VM.Clone' permissions on /vms/{vmid}, and 'VM.Allocate' permissions on /vms/{newid} (or on the VM pool /pool/{pool}). You also need 'Datastore.AllocateSpace' on any used storage, and 'SDN.Use' on any bridge."
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"newid\":\"100\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/lxc/100/clone'"
}

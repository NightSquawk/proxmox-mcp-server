{
  "operationId": "get_nodes_node_lxc_vmid_firewall_log",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "log",
  "method": "GET",
  "path": "/nodes/{node}/lxc/{vmid}/firewall/log",
  "description": "Read firewall log",
  "writeOperation": false,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [
    {
      "name": "limit",
      "type": "integer",
      "required": false,
      "minimum": 0,
      "typetext": "<integer> (0 - N)"
    },
    {
      "name": "since",
      "type": "integer",
      "required": false,
      "description": "Display log since this UNIX epoch.",
      "minimum": 0,
      "typetext": "<integer> (0 - N)"
    },
    {
      "name": "start",
      "type": "integer",
      "required": false,
      "minimum": 0,
      "typetext": "<integer> (0 - N)"
    },
    {
      "name": "until",
      "type": "integer",
      "required": false,
      "description": "Display log until this UNIX epoch.",
      "minimum": 0,
      "typetext": "<integer> (0 - N)"
    }
  ],
  "returns": {
    "items": {
      "properties": {
        "n": {
          "description": "Line number",
          "type": "integer"
        },
        "t": {
          "description": "Line text",
          "type": "string"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.Console"
      ]
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/lxc/100/firewall/log'"
}

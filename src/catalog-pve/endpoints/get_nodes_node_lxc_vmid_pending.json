{
  "operationId": "get_nodes_node_lxc_vmid_pending",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "vm_pending",
  "method": "GET",
  "path": "/nodes/{node}/lxc/{vmid}/pending",
  "description": "Get container configuration, including pending changes.",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [],
  "returns": {
    "items": {
      "properties": {
        "delete": {
          "description": "Indicates a pending delete request if present and not 0.",
          "maximum": 2,
          "minimum": 0,
          "optional": 1,
          "type": "integer"
        },
        "key": {
          "description": "Configuration option name.",
          "type": "string"
        },
        "pending": {
          "description": "Pending value.",
          "optional": 1,
          "type": "string"
        },
        "value": {
          "description": "Current value.",
          "optional": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.Audit"
      ]
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/lxc/100/pending'"
}

{
  "operationId": "post_nodes_node_wakeonlan",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "wakeonlan",
  "method": "POST",
  "path": "/nodes/{node}/wakeonlan",
  "description": "Try to wake a node via 'wake on LAN' network packet.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "target node for wake on LAN packet",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [],
  "returns": {
    "description": "MAC address used to assemble the WoL magic packet.",
    "format": "mac-addr",
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.PowerMgmt"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/wakeonlan'"
}

{
  "operationId": "delete_nodes_node_certificates_custom",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "remove_custom_cert",
  "method": "DELETE",
  "path": "/nodes/{node}/certificates/custom",
  "description": "DELETE custom certificate chain and key.",
  "writeOperation": true,
  "destructive": true,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "restart",
      "type": "boolean",
      "required": false,
      "description": "Restart pveproxy.",
      "default": 0,
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X DELETE -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/certificates/custom'"
}

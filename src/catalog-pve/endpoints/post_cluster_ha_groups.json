{
  "operationId": "post_cluster_ha_groups",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "create",
  "method": "POST",
  "path": "/cluster/ha/groups",
  "description": "Create a new HA group. (deprecated in favor of HA rules)",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "comment",
      "type": "string",
      "required": false,
      "description": "Description.",
      "maxLength": 4096,
      "typetext": "<string>"
    },
    {
      "name": "group",
      "type": "string",
      "required": true,
      "description": "The HA group identifier.",
      "format": "pve-configid",
      "typetext": "<string>"
    },
    {
      "name": "nodes",
      "type": "string",
      "required": true,
      "description": "List of cluster node names with optional priority.",
      "format": "pve-ha-node-list",
      "typetext": "<node>[:<pri>]{,<node>[:<pri>]}*"
    },
    {
      "name": "nofailback",
      "type": "boolean",
      "required": false,
      "description": "The CRM tries to run services on the node with the highest priority. If a node with higher priority comes online, the CRM migrates the service to that node. Enabling nofailback prevents that behavior.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "restricted",
      "type": "boolean",
      "required": false,
      "description": "Resources bound to restricted groups may only run on nodes defined by the group.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "type",
      "type": "string",
      "required": false,
      "description": "Group type.",
      "enum": [
        "group"
      ]
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Console"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"group\":\"<group>\",\"nodes\":\"<nodes>\"}' 'https://PVE_HOST:8006/api2/json/cluster/ha/groups'"
}

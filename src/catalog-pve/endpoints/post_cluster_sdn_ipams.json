{
  "operationId": "post_cluster_sdn_ipams",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "create",
  "method": "POST",
  "path": "/cluster/sdn/ipams",
  "description": "Create a new sdn ipam object.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "fingerprint",
      "type": "string",
      "required": false,
      "description": "Certificate SHA 256 fingerprint.",
      "pattern": "([A-Fa-f0-9]{2}:){31}[A-Fa-f0-9]{2}"
    },
    {
      "name": "ipam",
      "type": "string",
      "required": true,
      "description": "The SDN ipam object identifier.",
      "minLength": 2,
      "pattern": "[a-zA-Z][a-zA-Z0-9]*[a-zA-Z0-9]"
    },
    {
      "name": "lock-token",
      "type": "string",
      "required": false,
      "description": "the token for unlocking the global SDN configuration",
      "typetext": "<string>"
    },
    {
      "name": "section",
      "type": "integer",
      "required": false,
      "typetext": "<integer>"
    },
    {
      "name": "token",
      "type": "string",
      "required": false,
      "typetext": "<string>"
    },
    {
      "name": "type",
      "type": "string",
      "required": true,
      "description": "Plugin type.",
      "format": "pve-configid",
      "enum": [
        "netbox",
        "phpipam",
        "pve"
      ]
    },
    {
      "name": "url",
      "type": "string",
      "required": false,
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/sdn/ipams",
      [
        "SDN.Allocate"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"ipam\":\"<ipam>\",\"type\":\"netbox\"}' 'https://PVE_HOST:8006/api2/json/cluster/sdn/ipams'"
}

{
  "operationId": "post_nodes_node_ceph_mon_monid",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "createmon",
  "method": "POST",
  "path": "/nodes/{node}/ceph/mon/{monid}",
  "description": "Create a Ceph Monitor. Also auto-creates a Manager for the first monitor.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "monid",
      "type": "string",
      "required": false,
      "description": "The ID for the monitor, when omitted the same as the nodename.",
      "default": "nodename",
      "maxLength": 200,
      "pattern": "[a-zA-Z0-9]([a-zA-Z0-9\\-]*[a-zA-Z0-9])?"
    }
  ],
  "params": [
    {
      "name": "mon-address",
      "type": "string",
      "required": false,
      "description": "Overwrites autodetected monitor IP address(es). Must be in the public network(s) of Ceph.",
      "format": "ip-list",
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/ceph/mon/<monid>'"
}

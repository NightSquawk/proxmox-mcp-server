{
  "operationId": "get_nodes_node_qemu_vmid_rrd",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "rrd",
  "method": "GET",
  "path": "/nodes/{node}/qemu/{vmid}/rrd",
  "description": "Read VM RRD statistics (returns PNG)",
  "writeOperation": false,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [
    {
      "name": "cf",
      "type": "string",
      "required": false,
      "description": "The RRD consolidation function",
      "enum": [
        "AVERAGE",
        "MAX"
      ]
    },
    {
      "name": "ds",
      "type": "string",
      "required": true,
      "description": "The list of datasources you want to display.",
      "format": "pve-configid-list",
      "typetext": "<string>"
    },
    {
      "name": "timeframe",
      "type": "string",
      "required": true,
      "description": "Specify the time frame you are interested in.",
      "enum": [
        "hour",
        "day",
        "week",
        "month",
        "year"
      ]
    }
  ],
  "returns": {
    "properties": {
      "filename": {
        "type": "string"
      }
    },
    "type": "object"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.Audit"
      ]
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/qemu/100/rrd?ds=<ds>&timeframe=hour'"
}

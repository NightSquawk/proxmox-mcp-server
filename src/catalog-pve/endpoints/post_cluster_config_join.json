{
  "operationId": "post_cluster_config_join",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "join",
  "method": "POST",
  "path": "/cluster/config/join",
  "description": "Joins this node into an existing cluster. If no links are given, default to IP resolved by node's hostname on single link (fallback fails for clusters with multiple links).",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "fingerprint",
      "type": "string",
      "required": true,
      "description": "Certificate SHA 256 fingerprint.",
      "pattern": "([A-Fa-f0-9]{2}:){31}[A-Fa-f0-9]{2}"
    },
    {
      "name": "force",
      "type": "boolean",
      "required": false,
      "description": "Do not throw error if node already exists.",
      "typetext": "<boolean>"
    },
    {
      "name": "hostname",
      "type": "string",
      "required": true,
      "description": "Hostname (or IP) of an existing cluster member.",
      "typetext": "<string>"
    },
    {
      "name": "link[n]",
      "type": "string",
      "required": false,
      "description": "Address and priority information of a single corosync link. (up to 8 links supported; link0..link7)",
      "format": {
        "address": {
          "default_key": 1,
          "description": "Hostname (or IP) of this corosync link address.",
          "format": "address",
          "format_description": "IP",
          "type": "string"
        },
        "priority": {
          "default": 0,
          "description": "The priority for the link when knet is used in 'passive' mode (default). Lower value means higher priority. Only valid for cluster create, ignored on node add.",
          "maximum": 255,
          "minimum": 0,
          "optional": 1,
          "type": "integer"
        }
      },
      "typetext": "[address=]<IP> [,priority=<integer>]"
    },
    {
      "name": "nodeid",
      "type": "integer",
      "required": false,
      "description": "Node id for this node.",
      "minimum": 1,
      "typetext": "<integer> (1 - N)"
    },
    {
      "name": "password",
      "type": "string",
      "required": true,
      "description": "Superuser (root) password of peer node.",
      "maxLength": 128,
      "typetext": "<string>"
    },
    {
      "name": "votes",
      "type": "integer",
      "required": false,
      "description": "Number of votes for this node",
      "minimum": 0,
      "typetext": "<integer> (0 - N)"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": null,
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"fingerprint\":\"<fingerprint>\",\"hostname\":\"<hostname>\",\"password\":\"<password>\"}' 'https://PVE_HOST:8006/api2/json/cluster/config/join'"
}

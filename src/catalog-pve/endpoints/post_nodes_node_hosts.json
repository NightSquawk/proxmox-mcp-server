{
  "operationId": "post_nodes_node_hosts",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "write_etc_hosts",
  "method": "POST",
  "path": "/nodes/{node}/hosts",
  "description": "Write /etc/hosts.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "data",
      "type": "string",
      "required": true,
      "description": "The target content of /etc/hosts.",
      "typetext": "<string>"
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has a different digest. This can be used to prevent concurrent modifications.",
      "maxLength": 64,
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"data\":\"<data>\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/hosts'"
}

{
  "operationId": "post_nodes_node_vncshell",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "vncshell",
  "method": "POST",
  "path": "/nodes/{node}/vncshell",
  "description": "Creates a VNC Shell proxy.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "cmd",
      "type": "string",
      "required": false,
      "description": "Run specific command or default to login (requires 'root@pam')",
      "enum": [
        "ceph_install",
        "login",
        "upgrade"
      ],
      "default": "login"
    },
    {
      "name": "cmd-opts",
      "type": "string",
      "required": false,
      "description": "Add parameters to a command. Encoded as null terminated strings.",
      "default": "",
      "typetext": "<string>"
    },
    {
      "name": "height",
      "type": "integer",
      "required": false,
      "description": "sets the height of the console in pixels.",
      "minimum": 16,
      "maximum": 2160,
      "typetext": "<integer> (16 - 2160)"
    },
    {
      "name": "websocket",
      "type": "boolean",
      "required": false,
      "description": "use websocket instead of standard vnc.",
      "typetext": "<boolean>"
    },
    {
      "name": "width",
      "type": "integer",
      "required": false,
      "description": "sets the width of the console in pixels.",
      "minimum": 16,
      "maximum": 4096,
      "typetext": "<integer> (16 - 4096)"
    }
  ],
  "returns": {
    "additionalProperties": 0,
    "properties": {
      "cert": {
        "type": "string"
      },
      "password": {
        "description": "Password used for authentication within the VNC protocol. Consists of printable ASCII characters ('!' .. '~').",
        "optional": 1,
        "type": "string"
      },
      "port": {
        "type": "integer"
      },
      "ticket": {
        "type": "string"
      },
      "upid": {
        "type": "string"
      },
      "user": {
        "type": "string"
      }
    }
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.Console"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/vncshell'"
}

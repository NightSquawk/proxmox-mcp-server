{
  "operationId": "get_nodes_node_tasks_upid_log",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "read_task_log",
  "method": "GET",
  "path": "/nodes/{node}/tasks/{upid}/log",
  "description": "Read task log.",
  "writeOperation": false,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "upid",
      "type": "string",
      "required": true,
      "description": "The task's unique ID.",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "download",
      "type": "boolean",
      "required": false,
      "description": "Whether the tasklog file should be downloaded. This parameter can't be used in conjunction with other parameters",
      "typetext": "<boolean>"
    },
    {
      "name": "limit",
      "type": "integer",
      "required": false,
      "description": "The number of lines to read from the tasklog.",
      "default": 50,
      "minimum": 0,
      "typetext": "<integer> (0 - N)"
    },
    {
      "name": "start",
      "type": "integer",
      "required": false,
      "description": "Start at this line when reading the tasklog",
      "default": 0,
      "minimum": 0,
      "typetext": "<integer> (0 - N)"
    }
  ],
  "returns": {
    "items": {
      "properties": {
        "n": {
          "description": "Line number",
          "type": "integer"
        },
        "t": {
          "description": "Line text",
          "type": "string"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": {
    "description": "The user needs 'Sys.Audit' permissions on '/nodes/<node>' if they aren't the owner of the task.",
    "user": "all"
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/tasks/<upid>/log'"
}

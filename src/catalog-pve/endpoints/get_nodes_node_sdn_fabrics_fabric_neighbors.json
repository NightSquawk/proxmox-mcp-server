{
  "operationId": "get_nodes_node_sdn_fabrics_fabric_neighbors",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "neighbors",
  "method": "GET",
  "path": "/nodes/{node}/sdn/fabrics/{fabric}/neighbors",
  "description": "Get all neighbors for a fabric.",
  "writeOperation": false,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "fabric",
      "type": "string",
      "required": true,
      "description": "Identifier for SDN fabrics",
      "format": "pve-sdn-fabric-id",
      "minLength": 2,
      "maxLength": 8,
      "pattern": "[a-zA-Z0-9][a-zA-Z0-9-]{0,6}[a-zA-Z0-9]"
    }
  ],
  "params": [],
  "returns": {
    "items": {
      "properties": {
        "neighbor": {
          "description": "The IP or hostname of the neighbor.",
          "type": "string"
        },
        "status": {
          "description": "The status of the neighbor, as returned by FRR.",
          "type": "string"
        },
        "uptime": {
          "description": "The uptime of this neighbor, as returned by FRR (e.g. 8h24m12s).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": {
    "check": [
      "perm",
      "/sdn/fabrics/{fabric}",
      [
        "SDN.Audit"
      ]
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/sdn/fabrics/<fabric>/neighbors'"
}

{
  "operationId": "post_cluster_sdn_lock",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "lock",
  "method": "POST",
  "path": "/cluster/sdn/lock",
  "description": "Acquire global lock for SDN configuration",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "allow-pending",
      "type": "boolean",
      "required": false,
      "description": "if true, allow acquiring lock even though there are pending changes",
      "default": 0,
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/sdn",
      [
        "SDN.Allocate"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/cluster/sdn/lock'"
}

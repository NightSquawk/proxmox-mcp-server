{
  "operationId": "put_cluster_sdn_vnets_vnet_ips",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "ipupdate",
  "method": "PUT",
  "path": "/cluster/sdn/vnets/{vnet}/ips",
  "description": "Update IP Mapping in a VNet",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "vnet",
      "type": "string",
      "required": true,
      "description": "The SDN vnet object identifier.",
      "minLength": 2,
      "maxLength": 8,
      "pattern": "[a-zA-Z][a-zA-Z0-9]*[a-zA-Z0-9]"
    }
  ],
  "params": [
    {
      "name": "ip",
      "type": "string",
      "required": true,
      "description": "The IP address to associate with the given MAC address",
      "format": "ip",
      "typetext": "<string>"
    },
    {
      "name": "mac",
      "type": "string",
      "required": false,
      "description": "Unicast MAC address.",
      "format": "mac-addr",
      "typetext": "<XX:XX:XX:XX:XX:XX>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": false,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    },
    {
      "name": "zone",
      "type": "string",
      "required": true,
      "description": "The SDN zone object identifier.",
      "minLength": 2,
      "maxLength": 8,
      "pattern": "[a-zA-Z][a-zA-Z0-9]*[a-zA-Z0-9]"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/sdn/zones/{zone}/{vnet}",
      [
        "SDN.Allocate"
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"ip\":\"<ip>\",\"zone\":\"<zone>\"}' 'https://PVE_HOST:8006/api2/json/cluster/sdn/vnets/<vnet>/ips'"
}

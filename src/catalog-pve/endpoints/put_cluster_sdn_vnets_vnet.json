{
  "operationId": "put_cluster_sdn_vnets_vnet",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "update",
  "method": "PUT",
  "path": "/cluster/sdn/vnets/{vnet}",
  "description": "Update sdn vnet object configuration.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "vnet",
      "type": "string",
      "required": true,
      "description": "The SDN vnet object identifier.",
      "minLength": 2,
      "maxLength": 8,
      "pattern": "[a-zA-Z][a-zA-Z0-9]*[a-zA-Z0-9]"
    }
  ],
  "params": [
    {
      "name": "alias",
      "type": "string",
      "required": false,
      "description": "Alias name of the VNet.",
      "maxLength": 256,
      "pattern": "(?^i:[\\(\\)-_.\\w\\d\\s]{0,256})"
    },
    {
      "name": "delete",
      "type": "string",
      "required": false,
      "description": "A list of settings you want to delete.",
      "format": "pve-configid-list",
      "maxLength": 4096,
      "typetext": "<string>"
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has a different digest. This can be used to prevent concurrent modifications.",
      "maxLength": 64,
      "typetext": "<string>"
    },
    {
      "name": "isolate-ports",
      "type": "boolean",
      "required": false,
      "description": "If true, sets the isolated property for all interfaces on the bridge of this VNet.",
      "typetext": "<boolean>"
    },
    {
      "name": "lock-token",
      "type": "string",
      "required": false,
      "description": "the token for unlocking the global SDN configuration",
      "typetext": "<string>"
    },
    {
      "name": "tag",
      "type": "integer",
      "required": false,
      "description": "VLAN Tag (for VLAN or QinQ zones) or VXLAN VNI (for VXLAN or EVPN zones).",
      "minimum": 1,
      "maximum": 16777215,
      "typetext": "<integer> (1 - 16777215)"
    },
    {
      "name": "vlanaware",
      "type": "boolean",
      "required": false,
      "description": "Allow VLANs to pass through this vnet.",
      "typetext": "<boolean>"
    },
    {
      "name": "zone",
      "type": "string",
      "required": false,
      "description": "Name of the zone this VNet belongs to.",
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "description": "Require 'SDN.Allocate' permission on '/sdn/zones/<zone>/<vnet>'",
    "user": "all"
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/cluster/sdn/vnets/<vnet>'"
}

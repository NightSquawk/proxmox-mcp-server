{
  "operationId": "put_nodes_node_qemu_vmid_firewall_options",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "set_options",
  "method": "PUT",
  "path": "/nodes/{node}/qemu/{vmid}/firewall/options",
  "description": "Set Firewall options.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [
    {
      "name": "delete",
      "type": "string",
      "required": false,
      "description": "A list of settings you want to delete.",
      "format": "pve-configid-list",
      "typetext": "<string>"
    },
    {
      "name": "dhcp",
      "type": "boolean",
      "required": false,
      "description": "Enable DHCP.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has a different digest. This can be used to prevent concurrent modifications.",
      "maxLength": 64,
      "typetext": "<string>"
    },
    {
      "name": "enable",
      "type": "boolean",
      "required": false,
      "description": "Enable/disable firewall rules.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "ipfilter",
      "type": "boolean",
      "required": false,
      "description": "Enable default IP filters. This is equivalent to adding an empty ipfilter-net<id> ipset for every interface. Such ipsets implicitly contain sane default restrictions such as restricting IPv6 link local addresses to the one derived from the interface's MAC address. For containers the configured IP addresses will be implicitly added.",
      "typetext": "<boolean>"
    },
    {
      "name": "log_level_in",
      "type": "string",
      "required": false,
      "description": "Log level for incoming traffic.",
      "enum": [
        "emerg",
        "alert",
        "crit",
        "err",
        "warning",
        "notice",
        "info",
        "debug",
        "nolog"
      ]
    },
    {
      "name": "log_level_out",
      "type": "string",
      "required": false,
      "description": "Log level for outgoing traffic.",
      "enum": [
        "emerg",
        "alert",
        "crit",
        "err",
        "warning",
        "notice",
        "info",
        "debug",
        "nolog"
      ]
    },
    {
      "name": "macfilter",
      "type": "boolean",
      "required": false,
      "description": "Enable/disable MAC address filter.",
      "default": 1,
      "typetext": "<boolean>"
    },
    {
      "name": "ndp",
      "type": "boolean",
      "required": false,
      "description": "Enable NDP (Neighbor Discovery Protocol).",
      "default": 1,
      "typetext": "<boolean>"
    },
    {
      "name": "policy_in",
      "type": "string",
      "required": false,
      "description": "Input policy.",
      "enum": [
        "ACCEPT",
        "REJECT",
        "DROP"
      ]
    },
    {
      "name": "policy_out",
      "type": "string",
      "required": false,
      "description": "Output policy.",
      "enum": [
        "ACCEPT",
        "REJECT",
        "DROP"
      ]
    },
    {
      "name": "radv",
      "type": "boolean",
      "required": false,
      "description": "Allow sending Router Advertisement.",
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.Config.Network"
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/qemu/100/firewall/options'"
}

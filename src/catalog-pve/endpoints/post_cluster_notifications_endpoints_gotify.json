{
  "operationId": "post_cluster_notifications_endpoints_gotify",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "create_gotify_endpoint",
  "method": "POST",
  "path": "/cluster/notifications/endpoints/gotify",
  "description": "Create a new gotify endpoint",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "comment",
      "type": "string",
      "required": false,
      "description": "Comment",
      "typetext": "<string>"
    },
    {
      "name": "disable",
      "type": "boolean",
      "required": false,
      "description": "Disable this target",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "name",
      "type": "string",
      "required": true,
      "description": "The name of the endpoint.",
      "format": "pve-configid",
      "typetext": "<string>"
    },
    {
      "name": "server",
      "type": "string",
      "required": true,
      "description": "Server URL",
      "typetext": "<string>"
    },
    {
      "name": "token",
      "type": "string",
      "required": true,
      "description": "Secret token",
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "and",
      [
        "perm",
        "/mapping/notifications",
        [
          "Mapping.Modify"
        ]
      ],
      [
        "or",
        [
          "perm",
          "/",
          [
            "Sys.Audit",
            "Sys.Modify"
          ]
        ],
        [
          "perm",
          "/",
          [
            "Sys.AccessNetwork"
          ]
        ]
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"name\":\"<name>\",\"server\":\"<server>\",\"token\":\"<token>\"}' 'https://PVE_HOST:8006/api2/json/cluster/notifications/endpoints/gotify'"
}

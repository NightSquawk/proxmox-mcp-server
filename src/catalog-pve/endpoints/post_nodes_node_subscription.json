{
  "operationId": "post_nodes_node_subscription",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "update",
  "method": "POST",
  "path": "/nodes/{node}/subscription",
  "description": "Update subscription info.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "force",
      "type": "boolean",
      "required": false,
      "description": "Always connect to server, even if local cache is still valid.",
      "default": 0,
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/subscription'"
}

{
  "operationId": "post_nodes_node_ceph_mgr_id",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "createmgr",
  "method": "POST",
  "path": "/nodes/{node}/ceph/mgr/{id}",
  "description": "Create Ceph Manager",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "id",
      "type": "string",
      "required": false,
      "description": "The ID for the manager, when omitted the same as the nodename.",
      "default": "nodename",
      "maxLength": 200,
      "pattern": "[a-zA-Z0-9]([a-zA-Z0-9\\-]*[a-zA-Z0-9])?"
    }
  ],
  "params": [],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/ceph/mgr/<id>'"
}

{
  "operationId": "put_nodes_node_subscription",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "set",
  "method": "PUT",
  "path": "/nodes/{node}/subscription",
  "description": "Set subscription key.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "key",
      "type": "string",
      "required": true,
      "description": "Proxmox VE subscription key",
      "maxLength": 32,
      "pattern": "\\s*pve([1248])([cbsp])-[0-9a-f]{10}\\s*"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"key\":\"<key>\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/subscription'"
}

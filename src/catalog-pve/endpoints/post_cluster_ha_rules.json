{
  "operationId": "post_cluster_ha_rules",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "create_rule",
  "method": "POST",
  "path": "/cluster/ha/rules",
  "description": "Create HA rule.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "affinity",
      "type": "string",
      "required": false,
      "description": "Describes whether the HA resources are supposed to be kept on the same node ('positive'), or are supposed to be kept on separate nodes ('negative').",
      "enum": [
        "positive",
        "negative"
      ]
    },
    {
      "name": "comment",
      "type": "string",
      "required": false,
      "description": "HA rule description.",
      "maxLength": 4096,
      "typetext": "<string>"
    },
    {
      "name": "disable",
      "type": "boolean",
      "required": false,
      "description": "Whether the HA rule is disabled.",
      "typetext": "<boolean>"
    },
    {
      "name": "nodes",
      "type": "string",
      "required": false,
      "description": "List of cluster node names with optional priority.",
      "format": "pve-ha-node-list",
      "typetext": "<node>[:<pri>]{,<node>[:<pri>]}*"
    },
    {
      "name": "resources",
      "type": "string",
      "required": true,
      "description": "List of HA resource IDs. This consists of a list of resource types followed by a resource specific name separated with a colon (example: vm:100,ct:101).",
      "format": "pve-ha-resource-id-list",
      "typetext": "<type>:<name>{,<type>:<name>}*"
    },
    {
      "name": "rule",
      "type": "string",
      "required": true,
      "description": "HA rule identifier.",
      "format": "pve-configid",
      "typetext": "<string>"
    },
    {
      "name": "strict",
      "type": "boolean",
      "required": false,
      "description": "Describes whether the node affinity rule is strict or non-strict.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "type",
      "type": "string",
      "required": true,
      "description": "HA rule type.",
      "enum": [
        "node-affinity",
        "resource-affinity"
      ]
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Console"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"resources\":\"<resources>\",\"rule\":\"<rule>\",\"type\":\"node-affinity\"}' 'https://PVE_HOST:8006/api2/json/cluster/ha/rules'"
}

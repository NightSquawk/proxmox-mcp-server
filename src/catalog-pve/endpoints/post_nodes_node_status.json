{
  "operationId": "post_nodes_node_status",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "node_cmd",
  "method": "POST",
  "path": "/nodes/{node}/status",
  "description": "Reboot or shutdown a node.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "command",
      "type": "string",
      "required": true,
      "description": "Specify the command.",
      "enum": [
        "reboot",
        "shutdown"
      ]
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.PowerMgmt"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"command\":\"reboot\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/status'"
}

{
  "operationId": "put_cluster_mapping_usb_id",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "update",
  "method": "PUT",
  "path": "/cluster/mapping/usb/{id}",
  "description": "Update a hardware mapping.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "The ID of the logical USB mapping.",
      "format": "pve-configid",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "delete",
      "type": "string",
      "required": false,
      "description": "A list of settings you want to delete.",
      "format": "pve-configid-list",
      "maxLength": 4096,
      "typetext": "<string>"
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "description": "Description of the logical USB device.",
      "maxLength": 4096,
      "typetext": "<string>"
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has a different digest. This can be used to prevent concurrent modifications.",
      "maxLength": 64,
      "typetext": "<string>"
    },
    {
      "name": "map",
      "type": "array",
      "required": true,
      "description": "A list of maps for the cluster nodes.",
      "typetext": "<array>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/mapping/usb/{id}",
      [
        "Mapping.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"map\":\"<map>\"}' 'https://PVE_HOST:8006/api2/json/cluster/mapping/usb/<id>'"
}

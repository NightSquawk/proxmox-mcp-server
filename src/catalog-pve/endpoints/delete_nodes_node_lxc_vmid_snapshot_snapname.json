{
  "operationId": "delete_nodes_node_lxc_vmid_snapshot_snapname",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "delsnapshot",
  "method": "DELETE",
  "path": "/nodes/{node}/lxc/{vmid}/snapshot/{snapname}",
  "description": "Delete a LXC snapshot.",
  "writeOperation": true,
  "destructive": true,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    },
    {
      "name": "snapname",
      "type": "string",
      "required": true,
      "description": "The name of the snapshot.",
      "format": "pve-configid",
      "maxLength": 40,
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "force",
      "type": "boolean",
      "required": false,
      "description": "For removal from config file, even if removing disk snapshots fails.",
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "description": "the task ID.",
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.Snapshot"
      ]
    ]
  },
  "requestSample": "curl -k -X DELETE -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/lxc/100/snapshot/<snapname>'"
}

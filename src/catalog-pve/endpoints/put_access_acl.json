{
  "operationId": "put_access_acl",
  "surface": "pve",
  "resource": "access",
  "category": "Access & Auth",
  "name": "update_acl",
  "method": "PUT",
  "path": "/access/acl",
  "description": "Update Access Control List (add or remove permissions).",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "delete",
      "type": "boolean",
      "required": false,
      "description": "Remove permissions (instead of adding it).",
      "typetext": "<boolean>"
    },
    {
      "name": "groups",
      "type": "string",
      "required": false,
      "description": "List of groups.",
      "format": "pve-groupid-list",
      "typetext": "<string>"
    },
    {
      "name": "path",
      "type": "string",
      "required": true,
      "description": "Access control path",
      "typetext": "<string>"
    },
    {
      "name": "propagate",
      "type": "boolean",
      "required": false,
      "description": "Allow to propagate (inherit) permissions.",
      "default": 1,
      "typetext": "<boolean>"
    },
    {
      "name": "roles",
      "type": "string",
      "required": true,
      "description": "List of roles.",
      "format": "pve-roleid-list",
      "typetext": "<string>"
    },
    {
      "name": "tokens",
      "type": "string",
      "required": false,
      "description": "List of API tokens.",
      "format": "pve-tokenid-list",
      "typetext": "<string>"
    },
    {
      "name": "users",
      "type": "string",
      "required": false,
      "description": "List of users.",
      "format": "pve-userid-list",
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm-modify",
      "{path}"
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"path\":\"<path>\",\"roles\":\"<roles>\"}' 'https://PVE_HOST:8006/api2/json/access/acl'"
}

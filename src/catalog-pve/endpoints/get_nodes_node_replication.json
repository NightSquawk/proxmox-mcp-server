{
  "operationId": "get_nodes_node_replication",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "status",
  "method": "GET",
  "path": "/nodes/{node}/replication",
  "description": "List status of all replication jobs on this node.",
  "writeOperation": false,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "guest",
      "type": "integer",
      "required": false,
      "description": "Only list replication jobs for this guest.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "returns": {
    "items": {
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "links": [
      {
        "href": "{id}",
        "rel": "child"
      }
    ],
    "type": "array"
  },
  "permissions": {
    "description": "Requires the VM.Audit permission on /vms/<vmid>.",
    "user": "all"
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/replication'"
}

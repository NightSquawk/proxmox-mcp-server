{
  "operationId": "get_nodes_node_qemu_vmid_snapshot_snapname_config",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "get_snapshot_config",
  "method": "GET",
  "path": "/nodes/{node}/qemu/{vmid}/snapshot/{snapname}/config",
  "description": "Get snapshot configuration",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    },
    {
      "name": "snapname",
      "type": "string",
      "required": true,
      "description": "The name of the snapshot.",
      "format": "pve-configid",
      "maxLength": 40,
      "typetext": "<string>"
    }
  ],
  "params": [],
  "returns": {
    "type": "object"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.Snapshot",
        "VM.Snapshot.Rollback",
        "VM.Audit"
      ],
      "any",
      1
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/qemu/100/snapshot/<snapname>/config'"
}

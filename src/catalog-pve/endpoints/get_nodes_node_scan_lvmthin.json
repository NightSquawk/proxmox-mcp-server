{
  "operationId": "get_nodes_node_scan_lvmthin",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "lvmthinscan",
  "method": "GET",
  "path": "/nodes/{node}/scan/lvmthin",
  "description": "List local LVM Thin Pools.",
  "writeOperation": false,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "vg",
      "type": "string",
      "required": true,
      "maxLength": 100,
      "pattern": "[a-zA-Z0-9\\.\\+\\_][a-zA-Z0-9\\.\\+\\_\\-]+"
    }
  ],
  "returns": {
    "items": {
      "properties": {
        "lv": {
          "description": "The LVM Thin Pool name (LVM logical volume).",
          "type": "string"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": {
    "check": [
      "perm",
      "/storage",
      [
        "Datastore.Allocate"
      ]
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/scan/lvmthin?vg=<vg>'"
}

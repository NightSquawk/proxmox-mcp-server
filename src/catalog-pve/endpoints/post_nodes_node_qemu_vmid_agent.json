{
  "operationId": "post_nodes_node_qemu_vmid_agent",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "agent",
  "method": "POST",
  "path": "/nodes/{node}/qemu/{vmid}/agent",
  "description": "Execute QEMU Guest Agent commands.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [
    {
      "name": "command",
      "type": "string",
      "required": true,
      "description": "The QGA command.",
      "enum": [
        "fsfreeze-freeze",
        "fsfreeze-status",
        "fsfreeze-thaw",
        "fstrim",
        "get-fsinfo",
        "get-host-name",
        "get-memory-block-info",
        "get-memory-blocks",
        "get-osinfo",
        "get-time",
        "get-timezone",
        "get-users",
        "get-vcpus",
        "info",
        "network-get-interfaces",
        "ping",
        "shutdown",
        "suspend-disk",
        "suspend-hybrid",
        "suspend-ram"
      ]
    }
  ],
  "returns": {
    "description": "Returns an object with a single `result` property.",
    "type": "object"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.GuestAgent.Unrestricted",
        "VM.GuestAgent.Unrestricted"
      ],
      "any",
      1
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"command\":\"fsfreeze-freeze\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/qemu/100/agent'"
}

{
  "operationId": "put_access_tfa_userid_id",
  "surface": "pve",
  "resource": "access",
  "category": "Access & Auth",
  "name": "update_tfa_entry",
  "method": "PUT",
  "path": "/access/tfa/{userid}/{id}",
  "description": "Add a TFA entry for a user.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": false,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "userid",
      "type": "string",
      "required": true,
      "description": "Full User ID, in the `name@realm` format.",
      "format": "pve-userid",
      "maxLength": 64,
      "typetext": "<string>"
    },
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "A TFA entry id.",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "description",
      "type": "string",
      "required": false,
      "description": "A description to distinguish multiple entries from one another",
      "maxLength": 255,
      "typetext": "<string>"
    },
    {
      "name": "enable",
      "type": "boolean",
      "required": false,
      "description": "Whether the entry should be enabled for login.",
      "typetext": "<boolean>"
    },
    {
      "name": "password",
      "type": "string",
      "required": false,
      "description": "The current password of the user performing the change.",
      "minLength": 5,
      "maxLength": 64,
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "or",
      [
        "userid-param",
        "self"
      ],
      [
        "userid-group",
        [
          "User.Modify"
        ]
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/access/tfa/<userid>/<id>'"
}

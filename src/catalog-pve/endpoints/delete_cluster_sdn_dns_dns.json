{
  "operationId": "delete_cluster_sdn_dns_dns",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "delete",
  "method": "DELETE",
  "path": "/cluster/sdn/dns/{dns}",
  "description": "Delete sdn dns object configuration.",
  "writeOperation": true,
  "destructive": true,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "dns",
      "type": "string",
      "required": true,
      "description": "The SDN dns object identifier.",
      "minLength": 2,
      "pattern": "[a-zA-Z][a-zA-Z0-9]*[a-zA-Z0-9]"
    }
  ],
  "params": [
    {
      "name": "lock-token",
      "type": "string",
      "required": false,
      "description": "the token for unlocking the global SDN configuration",
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/sdn/dns",
      [
        "SDN.Allocate"
      ]
    ]
  },
  "requestSample": "curl -k -X DELETE -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/cluster/sdn/dns/<dns>'"
}

{
  "operationId": "post_nodes_node_disks_directory",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "create",
  "method": "POST",
  "path": "/nodes/{node}/disks/directory",
  "description": "Create a Filesystem on an unused disk. Will be mounted under '/mnt/pve/NAME'.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "add_storage",
      "type": "boolean",
      "required": false,
      "description": "Configure storage using the directory.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "device",
      "type": "string",
      "required": true,
      "description": "The block device you want to create the filesystem on.",
      "typetext": "<string>"
    },
    {
      "name": "filesystem",
      "type": "string",
      "required": false,
      "description": "The desired filesystem.",
      "enum": [
        "ext4",
        "xfs"
      ],
      "default": "ext4"
    },
    {
      "name": "name",
      "type": "string",
      "required": true,
      "description": "The storage identifier.",
      "format": "pve-storage-id",
      "typetext": "<storage ID>"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Modify"
      ]
    ],
    "description": "Requires additionally 'Datastore.Allocate' on /storage when setting 'add_storage'"
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"device\":\"<device>\",\"name\":\"<name>\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/disks/directory'"
}

{
  "operationId": "put_nodes_node_qemu_vmid_resize",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "resize_vm",
  "method": "PUT",
  "path": "/nodes/{node}/qemu/{vmid}/resize",
  "description": "Extend volume size.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has different SHA1 digest. This can be used to prevent concurrent modifications.",
      "maxLength": 40,
      "typetext": "<string>"
    },
    {
      "name": "disk",
      "type": "string",
      "required": true,
      "description": "The disk you want to resize.",
      "enum": [
        "ide0",
        "ide1",
        "ide2",
        "ide3",
        "scsi0",
        "scsi1",
        "scsi2",
        "scsi3",
        "scsi4",
        "scsi5",
        "scsi6",
        "scsi7",
        "scsi8",
        "scsi9",
        "scsi10",
        "scsi11",
        "scsi12",
        "scsi13",
        "scsi14",
        "scsi15",
        "scsi16",
        "scsi17",
        "scsi18",
        "scsi19",
        "scsi20",
        "scsi21",
        "scsi22",
        "scsi23",
        "scsi24",
        "scsi25",
        "scsi26",
        "scsi27",
        "scsi28",
        "scsi29",
        "scsi30",
        "virtio0",
        "virtio1",
        "virtio2",
        "virtio3",
        "virtio4",
        "virtio5",
        "virtio6",
        "virtio7",
        "virtio8",
        "virtio9",
        "virtio10",
        "virtio11",
        "virtio12",
        "virtio13",
        "virtio14",
        "virtio15",
        "sata0",
        "sata1",
        "sata2",
        "sata3",
        "sata4",
        "sata5",
        "efidisk0",
        "tpmstate0"
      ]
    },
    {
      "name": "size",
      "type": "string",
      "required": true,
      "description": "The new size. With the `+` sign the value is added to the actual size of the volume and without it, the value is taken as an absolute one. Shrinking disk size is not supported.",
      "pattern": "\\+?\\d+(\\.\\d+)?[KMGT]?"
    },
    {
      "name": "skiplock",
      "type": "boolean",
      "required": false,
      "description": "Ignore locks - only root is allowed to use this option.",
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "description": "the task ID.",
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.Config.Disk"
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"disk\":\"ide0\",\"size\":\"<size>\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/qemu/100/resize'"
}

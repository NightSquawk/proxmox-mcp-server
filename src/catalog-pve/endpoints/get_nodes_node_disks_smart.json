{
  "operationId": "get_nodes_node_disks_smart",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "smart",
  "method": "GET",
  "path": "/nodes/{node}/disks/smart",
  "description": "Get SMART Health of a disk.",
  "writeOperation": false,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "disk",
      "type": "string",
      "required": true,
      "description": "Block device name",
      "pattern": "^/dev/[a-zA-Z0-9\\/]+$"
    },
    {
      "name": "healthonly",
      "type": "boolean",
      "required": false,
      "description": "If true returns only the health status",
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "properties": {
      "attributes": {
        "optional": 1,
        "type": "array"
      },
      "health": {
        "type": "string"
      },
      "text": {
        "optional": 1,
        "type": "string"
      },
      "type": {
        "optional": 1,
        "type": "string"
      }
    },
    "type": "object"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Audit"
      ]
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/disks/smart?disk=<disk>'"
}

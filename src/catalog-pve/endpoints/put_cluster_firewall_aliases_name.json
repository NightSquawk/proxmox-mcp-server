{
  "operationId": "put_cluster_firewall_aliases_name",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "update_alias",
  "method": "PUT",
  "path": "/cluster/firewall/aliases/{name}",
  "description": "Update IP or Network alias.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "name",
      "type": "string",
      "required": true,
      "description": "Alias name.",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "[A-Za-z][A-Za-z0-9\\-\\_]+"
    }
  ],
  "params": [
    {
      "name": "cidr",
      "type": "string",
      "required": true,
      "description": "Network/IP specification in CIDR format.",
      "format": "IPorCIDR",
      "typetext": "<string>"
    },
    {
      "name": "comment",
      "type": "string",
      "required": false,
      "typetext": "<string>"
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has a different digest. This can be used to prevent concurrent modifications.",
      "maxLength": 64,
      "typetext": "<string>"
    },
    {
      "name": "rename",
      "type": "string",
      "required": false,
      "description": "Rename an existing alias.",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "[A-Za-z][A-Za-z0-9\\-\\_]+"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"cidr\":\"<cidr>\"}' 'https://PVE_HOST:8006/api2/json/cluster/firewall/aliases/<name>'"
}

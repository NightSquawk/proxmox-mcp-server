{
  "operationId": "get_nodes_node_query_oci_repo_tags",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "query_oci_repo_tags",
  "method": "GET",
  "path": "/nodes/{node}/query-oci-repo-tags",
  "description": "List all tags for an OCI repository reference.",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "reference",
      "type": "string",
      "required": true,
      "description": "The reference to the repository to query tags from.",
      "pattern": "^(?:(?:[a-zA-Z\\d]|[a-zA-Z\\d][a-zA-Z\\d-]*[a-zA-Z\\d])(?:\\.(?:[a-zA-Z\\d]|[a-zA-Z\\d][a-zA-Z\\d-]*[a-zA-Z\\d]))*(?::\\d+)?/)?[a-z\\d]+(?:(?:[._]|__|[-]*)[a-z\\d]+)*(?:/[a-z\\d]+(?:(?:[._]|__|[-]*)[a-z\\d]+)*)*$"
    }
  ],
  "returns": {
    "items": {
      "type": "string"
    },
    "type": "array"
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.AccessNetwork"
      ]
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/query-oci-repo-tags?reference=<reference>'"
}

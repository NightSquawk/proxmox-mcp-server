{
  "operationId": "delete_nodes_node_disks_lvmthin_name",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "delete",
  "method": "DELETE",
  "path": "/nodes/{node}/disks/lvmthin/{name}",
  "description": "Remove an LVM thin pool.",
  "writeOperation": true,
  "destructive": true,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "name",
      "type": "string",
      "required": true,
      "description": "The storage identifier.",
      "format": "pve-storage-id",
      "typetext": "<storage ID>"
    }
  ],
  "params": [
    {
      "name": "cleanup-config",
      "type": "boolean",
      "required": false,
      "description": "Marks associated storage(s) as not available on this node anymore or removes them from the configuration (if configured for this node only).",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "cleanup-disks",
      "type": "boolean",
      "required": false,
      "description": "Also wipe disks so they can be repurposed afterwards.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "volume-group",
      "type": "string",
      "required": true,
      "description": "The storage identifier.",
      "format": "pve-storage-id",
      "typetext": "<storage ID>"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Modify"
      ]
    ],
    "description": "Requires additionally 'Datastore.Allocate' on /storage when setting 'cleanup-config'"
  },
  "requestSample": "curl -k -X DELETE -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/disks/lvmthin/<name>?volume-group=<volume-group>'"
}

{
  "operationId": "post_nodes_node_qemu_vmid_status_suspend",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "vm_suspend",
  "method": "POST",
  "path": "/nodes/{node}/qemu/{vmid}/status/suspend",
  "description": "Suspend virtual machine.",
  "writeOperation": true,
  "destructive": true,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [
    {
      "name": "skiplock",
      "type": "boolean",
      "required": false,
      "description": "Ignore locks - only root is allowed to use this option.",
      "typetext": "<boolean>"
    },
    {
      "name": "statestorage",
      "type": "string",
      "required": false,
      "description": "The storage for the VM state",
      "format": "pve-storage-id",
      "typetext": "<storage ID>"
    },
    {
      "name": "todisk",
      "type": "boolean",
      "required": false,
      "description": "If set, suspends the VM to disk. Will be resumed on next VM start.",
      "default": 0,
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.PowerMgmt"
      ]
    ],
    "description": "You need 'VM.PowerMgmt' on /vms/{vmid}, and if you have set 'todisk', you need also 'VM.Config.Disk' on /vms/{vmid} and 'Datastore.AllocateSpace' on the storage for the vmstate."
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/qemu/100/status/suspend'"
}

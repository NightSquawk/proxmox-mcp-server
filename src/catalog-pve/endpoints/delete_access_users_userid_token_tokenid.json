{
  "operationId": "delete_access_users_userid_token_tokenid",
  "surface": "pve",
  "resource": "access",
  "category": "Access & Auth",
  "name": "remove_token",
  "method": "DELETE",
  "path": "/access/users/{userid}/token/{tokenid}",
  "description": "Remove API token for a specific user.",
  "writeOperation": true,
  "destructive": true,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "userid",
      "type": "string",
      "required": true,
      "description": "Full User ID, in the `name@realm` format.",
      "format": "pve-userid",
      "maxLength": 64,
      "typetext": "<string>"
    },
    {
      "name": "tokenid",
      "type": "string",
      "required": true,
      "description": "User-specific token identifier.",
      "pattern": "(?^:[A-Za-z][A-Za-z0-9\\.\\-_]+)"
    }
  ],
  "params": [],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "or",
      [
        "userid-param",
        "self"
      ],
      [
        "userid-group",
        [
          "User.Modify"
        ]
      ]
    ]
  },
  "requestSample": "curl -k -X DELETE -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/access/users/<userid>/token/<tokenid>'"
}

{
  "operationId": "post_nodes_node_lxc_vmid_template",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "template",
  "method": "POST",
  "path": "/nodes/{node}/lxc/{vmid}/template",
  "description": "Create a Template.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.Allocate"
      ]
    ],
    "description": "You need 'VM.Allocate' permissions on /vms/{vmid}"
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/lxc/100/template'"
}

{
  "operationId": "post_nodes_node_storage_storage_download_url",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "download_url",
  "method": "POST",
  "path": "/nodes/{node}/storage/{storage}/download-url",
  "description": "Download templates, ISO images, OVAs and VM images by using an URL.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "storage",
      "type": "string",
      "required": true,
      "description": "The storage identifier.",
      "format": "pve-storage-id",
      "typetext": "<storage ID>"
    }
  ],
  "params": [
    {
      "name": "checksum",
      "type": "string",
      "required": false,
      "description": "The expected checksum of the file.",
      "typetext": "<string>"
    },
    {
      "name": "checksum-algorithm",
      "type": "string",
      "required": false,
      "description": "The algorithm to calculate the checksum of the file.",
      "enum": [
        "md5",
        "sha1",
        "sha224",
        "sha256",
        "sha384",
        "sha512"
      ]
    },
    {
      "name": "compression",
      "type": "string",
      "required": false,
      "description": "Decompress the downloaded file using the specified compression algorithm.",
      "enum": null,
      "typetext": "<string>"
    },
    {
      "name": "content",
      "type": "string",
      "required": true,
      "description": "Content type.",
      "format": "pve-storage-content",
      "enum": [
        "iso",
        "vztmpl",
        "import"
      ]
    },
    {
      "name": "filename",
      "type": "string",
      "required": true,
      "description": "The name of the file to create. Caution: This will be normalized!",
      "maxLength": 255,
      "typetext": "<string>"
    },
    {
      "name": "url",
      "type": "string",
      "required": true,
      "description": "The URL to download the file from.",
      "pattern": "https?://.*"
    },
    {
      "name": "verify-certificates",
      "type": "boolean",
      "required": false,
      "description": "If false, no SSL/TLS certificates will be verified.",
      "default": 1,
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "and",
      [
        "perm",
        "/storage/{storage}",
        [
          "Datastore.AllocateTemplate"
        ]
      ],
      [
        "or",
        [
          "perm",
          "/",
          [
            "Sys.Audit",
            "Sys.Modify"
          ]
        ],
        [
          "perm",
          "/nodes/{node}",
          [
            "Sys.AccessNetwork"
          ]
        ]
      ]
    ],
    "description": "Requires allocation access on the storage and as this allows one to probe the (local!) host network indirectly it also requires one of Sys.Modify on / (for backwards compatibility) or the newer Sys.AccessNetwork privilege on the node."
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"content\":\"iso\",\"filename\":\"<filename>\",\"url\":\"<url>\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/storage/<storage>/download-url'"
}

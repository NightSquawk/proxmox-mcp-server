{
  "operationId": "post_nodes_node_ceph_fs_name",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "createfs",
  "method": "POST",
  "path": "/nodes/{node}/ceph/fs/{name}",
  "description": "Create a Ceph filesystem",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "name",
      "type": "string",
      "required": false,
      "description": "The ceph filesystem name.",
      "default": "cephfs",
      "pattern": "(?^:^[^:/\\s]+$)"
    }
  ],
  "params": [
    {
      "name": "add-storage",
      "type": "boolean",
      "required": false,
      "description": "Configure the created CephFS as storage for this cluster.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "pg_num",
      "type": "integer",
      "required": false,
      "description": "Number of placement groups for the backing data pool. The metadata pool will use a quarter of this.",
      "default": 128,
      "minimum": 8,
      "maximum": 32768,
      "typetext": "<integer> (8 - 32768)"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/ceph/fs/<name>'"
}

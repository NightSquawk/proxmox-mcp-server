{
  "operationId": "post_nodes_node_qemu_vmid_agent_set_user_password",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "set-user-password",
  "method": "POST",
  "path": "/nodes/{node}/qemu/{vmid}/agent/set-user-password",
  "description": "Sets the password for the given user to the given password",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [
    {
      "name": "crypted",
      "type": "boolean",
      "required": false,
      "description": "set to 1 if the password has already been passed through crypt()",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "password",
      "type": "string",
      "required": true,
      "description": "The new password.",
      "minLength": 5,
      "maxLength": 1024,
      "typetext": "<string>"
    },
    {
      "name": "username",
      "type": "string",
      "required": true,
      "description": "The user to set the password for.",
      "typetext": "<string>"
    }
  ],
  "returns": {
    "description": "Returns an object with a single `result` property.",
    "type": "object"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.GuestAgent.Unrestricted"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"password\":\"<password>\",\"username\":\"<username>\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/qemu/100/agent/set-user-password'"
}

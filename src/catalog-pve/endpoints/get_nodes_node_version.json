{
  "operationId": "get_nodes_node_version",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "version",
  "method": "GET",
  "path": "/nodes/{node}/version",
  "description": "API version details",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [],
  "returns": {
    "properties": {
      "release": {
        "description": "The current installed Proxmox VE Release",
        "type": "string"
      },
      "repoid": {
        "description": "The short git commit hash ID from which this version was build",
        "type": "string"
      },
      "version": {
        "description": "The current installed pve-manager package version",
        "type": "string"
      }
    },
    "type": "object"
  },
  "permissions": {
    "user": "all"
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/version'"
}

{
  "operationId": "post_cluster_mapping_usb",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "create",
  "method": "POST",
  "path": "/cluster/mapping/usb",
  "description": "Create a new hardware mapping.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "description",
      "type": "string",
      "required": false,
      "description": "Description of the logical USB device.",
      "maxLength": 4096,
      "typetext": "<string>"
    },
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "The ID of the logical USB mapping.",
      "format": "pve-configid",
      "typetext": "<string>"
    },
    {
      "name": "map",
      "type": "array",
      "required": true,
      "description": "A list of maps for the cluster nodes.",
      "typetext": "<array>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/mapping/usb",
      [
        "Mapping.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"id\":\"<id>\",\"map\":\"<map>\"}' 'https://PVE_HOST:8006/api2/json/cluster/mapping/usb'"
}

{
  "operationId": "post_cluster_replication",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "create",
  "method": "POST",
  "path": "/cluster/replication",
  "description": "Create a new replication job",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "comment",
      "type": "string",
      "required": false,
      "description": "Description.",
      "maxLength": 4096,
      "typetext": "<string>"
    },
    {
      "name": "disable",
      "type": "boolean",
      "required": false,
      "description": "Flag to disable/deactivate the entry.",
      "typetext": "<boolean>"
    },
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "Replication Job ID. The ID is composed of a Guest ID and a job number, separated by a hyphen, i.e. '<GUEST>-<JOBNUM>'.",
      "format": "pve-replication-job-id",
      "pattern": "[1-9][0-9]{2,8}-\\d{1,9}"
    },
    {
      "name": "rate",
      "type": "number",
      "required": false,
      "description": "Rate limit in mbps (megabytes per second) as floating point number.",
      "minimum": 1,
      "typetext": "<number> (1 - N)"
    },
    {
      "name": "remove_job",
      "type": "string",
      "required": false,
      "description": "Mark the replication job for removal. The job will remove all local replication snapshots. When set to 'full', it also tries to remove replicated volumes on the target. The job then removes itself from the configuration file.",
      "enum": [
        "local",
        "full"
      ]
    },
    {
      "name": "schedule",
      "type": "string",
      "required": false,
      "description": "Storage replication schedule. The format is a subset of `systemd` calendar events.",
      "format": "pve-calendar-event",
      "default": "*/15",
      "maxLength": 128,
      "typetext": "<string>"
    },
    {
      "name": "source",
      "type": "string",
      "required": false,
      "description": "For internal use, to detect if the guest was stolen.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "target",
      "type": "string",
      "required": true,
      "description": "Target node.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "type",
      "type": "string",
      "required": true,
      "description": "Section type.",
      "enum": [
        "local"
      ]
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "description": "Requires the VM.Replicate permission on /vms/<vmid>.",
    "user": "all"
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"id\":\"<id>\",\"target\":\"<target>\",\"type\":\"local\"}' 'https://PVE_HOST:8006/api2/json/cluster/replication'"
}

{
  "operationId": "put_nodes_node_qemu_vmid_unlink",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "unlink",
  "method": "PUT",
  "path": "/nodes/{node}/qemu/{vmid}/unlink",
  "description": "Unlink/delete disk images.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [
    {
      "name": "force",
      "type": "boolean",
      "required": false,
      "description": "Force physical removal. Without this, we simple remove the disk from the config file and create an additional configuration entry called 'unused[n]', which contains the volume ID. Unlink of unused[n] always cause physical removal.",
      "typetext": "<boolean>"
    },
    {
      "name": "idlist",
      "type": "string",
      "required": true,
      "description": "A list of disk IDs you want to delete.",
      "format": "pve-configid-list",
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.Config.Disk"
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"idlist\":\"<idlist>\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/qemu/100/unlink'"
}

{
  "operationId": "get_cluster_sdn_vnets_vnet_subnets_subnet",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "read",
  "method": "GET",
  "path": "/cluster/sdn/vnets/{vnet}/subnets/{subnet}",
  "description": "Read sdn subnet configuration.",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,

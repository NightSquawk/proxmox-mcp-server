      "maxLength": 8,
      "pattern": "[a-zA-Z][a-zA-Z0-9]*[a-zA-Z0-9]"
    },
    {
      "name": "subnet",
      "type": "string",
      "required": true,
      "description": "The SDN subnet object identifier.",
      "format": "pve-sdn-subnet-id",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "pending",
      "type": "boolean",
      "required": false,
      "description": "Display pending config.",
      "typetext": "<boolean>"
    },
    {
      "name": "running",
      "type": "boolean",
      "required": false,
      "description": "Display running config.",
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "type": "object"
  },
  "permissions": {

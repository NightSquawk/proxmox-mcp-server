{
  "operationId": "post_nodes_node_ceph_osd",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "createosd",
  "method": "POST",
  "path": "/nodes/{node}/ceph/osd",
  "description": "Create OSD",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "crush-device-class",
      "type": "string",
      "required": false,
      "description": "Set the device class of the OSD in crush.",
      "typetext": "<string>"
    },
    {
      "name": "db_dev",
      "type": "string",
      "required": false,
      "description": "Block device name for block.db.",
      "typetext": "<string>"
    },
    {
      "name": "db_dev_size",
      "type": "number",
      "required": false,
      "description": "Size in GiB for block.db.",
      "minimum": 1,
      "typetext": "<number> (1 - N)"
    },
    {
      "name": "dev",
      "type": "string",
      "required": true,
      "description": "Block device name.",
      "typetext": "<string>"
    },
    {
      "name": "encrypted",
      "type": "boolean",
      "required": false,
      "description": "Enables encryption of the OSD.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "osds-per-device",
      "type": "integer",
      "required": false,
      "description": "OSD services per physical device. Only useful for fast NVMe devices to utilize their performance better. Mutually exclusive with 'db_dev' and 'wal_dev'.",
      "minimum": 1,
      "typetext": "<integer> (1 - N)"
    },
    {
      "name": "wal_dev",
      "type": "string",
      "required": false,
      "description": "Block device name for block.wal.",
      "typetext": "<string>"
    },
    {
      "name": "wal_dev_size",
      "type": "number",
      "required": false,
      "description": "Size in GiB for block.wal.",
      "minimum": 0.5,
      "typetext": "<number> (0.5 - N)"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": null,
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"dev\":\"<dev>\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/ceph/osd'"
}

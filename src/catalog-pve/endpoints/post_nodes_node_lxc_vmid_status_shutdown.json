{
  "operationId": "post_nodes_node_lxc_vmid_status_shutdown",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "vm_shutdown",
  "method": "POST",
  "path": "/nodes/{node}/lxc/{vmid}/status/shutdown",
  "description": "Shutdown the container. This will trigger a clean shutdown of the container, see lxc-stop(1) for details.",
  "writeOperation": true,
  "destructive": true,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [
    {
      "name": "forceStop",
      "type": "boolean",
      "required": false,
      "description": "Make sure the Container stops.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "timeout",
      "type": "integer",
      "required": false,
      "description": "Wait maximal timeout seconds.",
      "default": 60,
      "minimum": 0,
      "typetext": "<integer> (0 - N)"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.PowerMgmt"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/lxc/100/status/shutdown'"
}

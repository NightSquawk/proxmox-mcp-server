{
  "operationId": "post_cluster_firewall_aliases",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "create_alias",
  "method": "POST",
  "path": "/cluster/firewall/aliases",
  "description": "Create IP or Network Alias.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "cidr",
      "type": "string",
      "required": true,
      "description": "Network/IP specification in CIDR format.",
      "format": "IPorCIDR",
      "typetext": "<string>"
    },
    {
      "name": "comment",
      "type": "string",
      "required": false,
      "typetext": "<string>"
    },
    {
      "name": "name",
      "type": "string",
      "required": true,
      "description": "Alias name.",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "[A-Za-z][A-Za-z0-9\\-\\_]+"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"cidr\":\"<cidr>\",\"name\":\"<name>\"}' 'https://PVE_HOST:8006/api2/json/cluster/firewall/aliases'"
}

          "properties": {
            "cksum": {
              "optional": 1,
              "type": "number"
            },
            "msg": {
              "description": "An optional message about the vdev.",
              "type": "string"
            },
            "name": {
              "description": "The name of the vdev or section.",
              "type": "string"
            },
            "read": {
              "optional": 1,
              "type": "number"
            },
            "state": {
              "description": "The state of the vdev.",
              "optional": 1,
              "type": "string"
            },
            "write": {
              "optional": 1,
              "type": "number"
            }

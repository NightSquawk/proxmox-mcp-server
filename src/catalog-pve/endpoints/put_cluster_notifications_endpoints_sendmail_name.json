{
  "operationId": "put_cluster_notifications_endpoints_sendmail_name",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "update_sendmail_endpoint",
  "method": "PUT",
  "path": "/cluster/notifications/endpoints/sendmail/{name}",
  "description": "Update existing sendmail endpoint",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "name",
      "type": "string",
      "required": true,
      "description": "The name of the endpoint.",
      "format": "pve-configid",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "author",
      "type": "string",
      "required": false,
      "description": "Author of the mail",
      "typetext": "<string>"
    },
    {
      "name": "comment",
      "type": "string",
      "required": false,
      "description": "Comment",
      "typetext": "<string>"
    },
    {
      "name": "delete",
      "type": "array",
      "required": false,
      "description": "A list of settings you want to delete.",
      "typetext": "<array>"
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has a different digest. This can be used to prevent concurrent modifications.",
      "maxLength": 64,
      "typetext": "<string>"
    },
    {
      "name": "disable",
      "type": "boolean",
      "required": false,
      "description": "Disable this target",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "from-address",
      "type": "string",
      "required": false,
      "description": "`From` address for the mail",
      "typetext": "<string>"
    },
    {
      "name": "mailto",
      "type": "array",
      "required": false,
      "description": "List of email recipients",
      "typetext": "<array>"
    },
    {
      "name": "mailto-user",
      "type": "array",
      "required": false,
      "description": "List of users",
      "typetext": "<array>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "and",
      [
        "perm",
        "/mapping/notifications",
        [
          "Mapping.Modify"
        ]
      ],
      [
        "or",
        [
          "perm",
          "/",
          [
            "Sys.Audit",
            "Sys.Modify"
          ]
        ],
        [
          "perm",
          "/",
          [
            "Sys.AccessNetwork"
          ]
        ]
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/cluster/notifications/endpoints/sendmail/<name>'"
}

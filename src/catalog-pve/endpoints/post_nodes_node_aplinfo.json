{
  "operationId": "post_nodes_node_aplinfo",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "apl_download",
  "method": "POST",
  "path": "/nodes/{node}/aplinfo",
  "description": "Download appliance templates.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "storage",
      "type": "string",
      "required": true,
      "description": "The storage where the template will be stored",
      "format": "pve-storage-id",
      "typetext": "<storage ID>"
    },
    {
      "name": "template",
      "type": "string",
      "required": true,
      "description": "The template which will downloaded",
      "maxLength": 255,
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/storage/{storage}",
      [
        "Datastore.AllocateTemplate"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"storage\":\"<storage>\",\"template\":\"<template>\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/aplinfo'"
}

{
  "operationId": "post_cluster_acme_account",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "register_account",
  "method": "POST",
  "path": "/cluster/acme/account",
  "description": "Register a new ACME account with CA.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "contact",
      "type": "string",
      "required": true,
      "description": "Contact email addresses.",
      "format": "email-list",
      "typetext": "<string>"
    },
    {
      "name": "directory",
      "type": "string",
      "required": false,
      "description": "URL of ACME CA directory endpoint.",
      "default": "https://acme-v02.api.letsencrypt.org/directory",
      "pattern": "^https?://.*"
    },
    {
      "name": "eab-hmac-key",
      "type": "string",
      "required": false,
      "description": "HMAC key for External Account Binding.",
      "typetext": "<string>"
    },
    {
      "name": "eab-kid",
      "type": "string",
      "required": false,
      "description": "Key Identifier for External Account Binding.",
      "typetext": "<string>"
    },
    {
      "name": "name",
      "type": "string",
      "required": false,
      "description": "ACME account config file name.",
      "format": "pve-configid",
      "default": "default",
      "typetext": "<name>"
    },
    {
      "name": "tos_url",
      "type": "string",
      "required": false,
      "description": "URL of CA TermsOfService - setting this indicates agreement.",
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": null,
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"contact\":\"<contact>\"}' 'https://PVE_HOST:8006/api2/json/cluster/acme/account'"
}

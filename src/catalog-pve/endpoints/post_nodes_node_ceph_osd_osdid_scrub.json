      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "osdid",
      "type": "integer",
      "required": true,
      "description": "OSD ID",
      "typetext": "<integer>"
    }
  ],
  "params": [
    {
      "name": "deep",
      "type": "boolean",
      "required": false,
      "description": "If set, instructs a deep scrub instead of a normal one.",
      "default": 0,
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/ceph/osd/0/scrub'"
}

{
  "operationId": "post_nodes_node_ceph_osd_osdid_scrub",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "scrub",
  "method": "POST",
  "path": "/nodes/{node}/ceph/osd/{osdid}/scrub",

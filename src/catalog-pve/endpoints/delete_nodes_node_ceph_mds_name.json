{
  "operationId": "delete_nodes_node_ceph_mds_name",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "destroymds",
  "method": "DELETE",
  "path": "/nodes/{node}/ceph/mds/{name}",
  "description": "Destroy Ceph Metadata Server",
  "writeOperation": true,
  "destructive": true,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "name",
      "type": "string",
      "required": true,
      "description": "The name (ID) of the mds",
      "pattern": "[a-zA-Z0-9]([a-zA-Z0-9\\-]*[a-zA-Z0-9])?"
    }
  ],
  "params": [],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X DELETE -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/ceph/mds/<name>'"
}

{
  "operationId": "post_nodes_node_qemu_vmid_status_stop",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "vm_stop",
  "method": "POST",
  "path": "/nodes/{node}/qemu/{vmid}/status/stop",
  "description": "Stop virtual machine. The qemu process will exit immediately. This is akin to pulling the power plug of a running computer and may damage the VM data.",
  "writeOperation": true,
  "destructive": true,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [
    {
      "name": "keepActive",
      "type": "boolean",
      "required": false,
      "description": "Do not deactivate storage volumes.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "migratedfrom",
      "type": "string",
      "required": false,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "overrule-shutdown",
      "type": "boolean",
      "required": false,
      "description": "Try to abort active 'qmshutdown' tasks before stopping.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "skiplock",
      "type": "boolean",
      "required": false,
      "description": "Ignore locks - only root is allowed to use this option.",
      "typetext": "<boolean>"
    },
    {
      "name": "timeout",
      "type": "integer",
      "required": false,
      "description": "Wait maximal timeout seconds.",
      "minimum": 0,
      "typetext": "<integer> (0 - N)"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.PowerMgmt"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/qemu/100/status/stop'"
}

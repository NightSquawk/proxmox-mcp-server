{
  "operationId": "put_nodes_node_time",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "set_timezone",
  "method": "PUT",
  "path": "/nodes/{node}/time",
  "description": "Set time zone.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "timezone",
      "type": "string",
      "required": true,
      "description": "Time zone. The file '/usr/share/zoneinfo/zone.tab' contains the list of valid names.",
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"timezone\":\"<timezone>\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/time'"
}

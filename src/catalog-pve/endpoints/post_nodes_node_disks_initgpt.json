{
  "operationId": "post_nodes_node_disks_initgpt",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "initgpt",
  "method": "POST",
  "path": "/nodes/{node}/disks/initgpt",
  "description": "Initialize Disk with GPT",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "disk",
      "type": "string",
      "required": true,
      "description": "Block device name",
      "pattern": "^/dev/[a-zA-Z0-9\\/]+$"
    },
    {
      "name": "uuid",
      "type": "string",
      "required": false,
      "description": "UUID for the GPT table",
      "maxLength": 36,
      "pattern": "[a-fA-F0-9\\-]+"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"disk\":\"<disk>\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/disks/initgpt'"
}

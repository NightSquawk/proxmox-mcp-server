{
  "operationId": "put_cluster_sdn_vnets_vnet_firewall_options",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "set_options",
  "method": "PUT",
  "path": "/cluster/sdn/vnets/{vnet}/firewall/options",
  "description": "Set Firewall options.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "vnet",
      "type": "string",
      "required": true,
      "description": "The SDN vnet object identifier.",
      "minLength": 2,
      "maxLength": 8,
      "pattern": "[a-zA-Z][a-zA-Z0-9]*[a-zA-Z0-9]"
    }
  ],
  "params": [
    {
      "name": "delete",
      "type": "string",
      "required": false,
      "description": "A list of settings you want to delete.",
      "format": "pve-configid-list",
      "typetext": "<string>"
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has a different digest. This can be used to prevent concurrent modifications.",
      "maxLength": 64,
      "typetext": "<string>"
    },
    {
      "name": "enable",
      "type": "boolean",
      "required": false,
      "description": "Enable/disable firewall rules.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "log_level_forward",
      "type": "string",
      "required": false,
      "description": "Log level for forwarded traffic.",
      "enum": [
        "emerg",
        "alert",
        "crit",
        "err",
        "warning",
        "notice",
        "info",
        "debug",
        "nolog"
      ]
    },
    {
      "name": "policy_forward",
      "type": "string",
      "required": false,
      "description": "Forward policy.",
      "enum": [
        "ACCEPT",
        "DROP"
      ]
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "description": "Needs SDN.Allocate permissions on '/sdn/zones/<zone>/<vnet>'",
    "user": "all"
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/cluster/sdn/vnets/<vnet>/firewall/options'"
}

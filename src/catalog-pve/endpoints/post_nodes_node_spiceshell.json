{
  "operationId": "post_nodes_node_spiceshell",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "spiceshell",
  "method": "POST",
  "path": "/nodes/{node}/spiceshell",
  "description": "Creates a SPICE shell.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "cmd",
      "type": "string",
      "required": false,
      "description": "Run specific command or default to login (requires 'root@pam')",
      "enum": [
        "ceph_install",
        "login",
        "upgrade"
      ],
      "default": "login"
    },
    {
      "name": "cmd-opts",
      "type": "string",
      "required": false,
      "description": "Add parameters to a command. Encoded as null terminated strings.",
      "default": "",
      "typetext": "<string>"
    },
    {
      "name": "proxy",
      "type": "string",
      "required": false,
      "description": "SPICE proxy server. This can be used by the client to specify the proxy server. All nodes in a cluster runs 'spiceproxy', so it is up to the client to choose one. By default, we return the node where the VM is currently running. As reasonable setting is to use same node you use to connect to the API (This is window.location.hostname for the JS GUI).",
      "format": "address",
      "typetext": "<string>"
    }
  ],
  "returns": {
    "additionalProperties": 1,
    "description": "Returned values can be directly passed to the 'remote-viewer' application.",
    "properties": {
      "host": {
        "type": "string"
      },
      "password": {
        "type": "string"
      },
      "proxy": {
        "type": "string"
      },
      "tls-port": {
        "type": "integer"
      },
      "type": {
        "type": "string"
      }
    }
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.Console"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/spiceshell'"
}

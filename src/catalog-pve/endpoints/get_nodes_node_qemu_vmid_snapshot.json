{
  "operationId": "get_nodes_node_qemu_vmid_snapshot",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "snapshot_list",
  "method": "GET",
  "path": "/nodes/{node}/qemu/{vmid}/snapshot",
  "description": "List all snapshots.",
  "writeOperation": false,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "The (unique) ID of the VM.",
      "format": "pve-vmid",
      "minimum": 100,
      "maximum": 999999999,
      "typetext": "<integer> (100 - 999999999)"
    }
  ],
  "params": [],
  "returns": {
    "items": {
      "properties": {
        "description": {
          "description": "Snapshot description.",
          "type": "string"
        },
        "name": {
          "description": "Snapshot identifier. Value 'current' identifies the current VM.",
          "type": "string"
        },
        "parent": {
          "description": "Parent snapshot identifier.",
          "optional": 1,
          "type": "string"
        },
        "snaptime": {
          "description": "Snapshot creation time",
          "optional": 1,
          "renderer": "timestamp",
          "type": "integer"
        },
        "vmstate": {
          "description": "Snapshot includes RAM.",
          "optional": 1,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "links": [
      {
        "href": "{name}",
        "rel": "child"
      }
    ],
    "type": "array"
  },
  "permissions": {
    "check": [
      "perm",
      "/vms/{vmid}",
      [
        "VM.Audit"
      ]
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' 'https://PVE_HOST:8006/api2/json/nodes/<node>/qemu/100/snapshot'"
}

{
  "operationId": "delete_cluster_sdn_vnets_vnet_subnets_subnet",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "delete",
  "method": "DELETE",
  "path": "/cluster/sdn/vnets/{vnet}/subnets/{subnet}",
  "description": "Delete sdn subnet object configuration.",
  "writeOperation": true,
  "destructive": true,
  "protected": true,

{
  "operationId": "put_cluster_sdn_ipams_ipam",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "update",
  "method": "PUT",
  "path": "/cluster/sdn/ipams/{ipam}",
  "description": "Update sdn ipam object configuration.",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "ipam",
      "type": "string",
      "required": true,
      "description": "The SDN ipam object identifier.",
      "minLength": 2,
      "pattern": "[a-zA-Z][a-zA-Z0-9]*[a-zA-Z0-9]"
    }
  ],
  "params": [
    {
      "name": "delete",
      "type": "string",
      "required": false,
      "description": "A list of settings you want to delete.",
      "format": "pve-configid-list",
      "maxLength": 4096,
      "typetext": "<string>"
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has a different digest. This can be used to prevent concurrent modifications.",
      "maxLength": 64,
      "typetext": "<string>"
    },
    {
      "name": "fingerprint",
      "type": "string",
      "required": false,
      "description": "Certificate SHA 256 fingerprint.",
      "pattern": "([A-Fa-f0-9]{2}:){31}[A-Fa-f0-9]{2}"
    },
    {
      "name": "lock-token",
      "type": "string",
      "required": false,
      "description": "the token for unlocking the global SDN configuration",
      "typetext": "<string>"
    },
    {
      "name": "section",
      "type": "integer",
      "required": false,
      "typetext": "<integer>"
    },
    {
      "name": "token",
      "type": "string",
      "required": false,
      "typetext": "<string>"
    },
    {
      "name": "url",
      "type": "string",
      "required": false,
      "typetext": "<string>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/sdn/ipams",
      [
        "SDN.Allocate"
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/cluster/sdn/ipams/<ipam>'"
}

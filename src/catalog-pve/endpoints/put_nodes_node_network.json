{
  "operationId": "put_nodes_node_network",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "reload_network_config",
  "method": "PUT",
  "path": "/nodes/{node}/network",
  "description": "Reload network configuration",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "regenerate-frr",
      "type": "boolean",
      "required": false,
      "description": "Whether FRR config generation should get skipped or not.",
      "default": 0,
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/network'"
}

{
  "operationId": "post_nodes_node_apt_update",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "update_database",
  "method": "POST",
  "path": "/nodes/{node}/apt/update",
  "description": "This is used to resynchronize the package index files from their sources (apt-get update).",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "notify",
      "type": "boolean",
      "required": false,
      "description": "Send notification about new packages.",
      "default": 0,
      "typetext": "<boolean>"
    },
    {
      "name": "quiet",
      "type": "boolean",
      "required": false,
      "description": "Only produces output suitable for logging, omitting progress indicators.",
      "default": 0,
      "typetext": "<boolean>"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": {
    "check": [
      "perm",
      "/nodes/{node}",
      [
        "Sys.Modify"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/apt/update'"
}

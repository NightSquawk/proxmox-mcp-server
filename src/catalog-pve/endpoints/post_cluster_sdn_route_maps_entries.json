{
  "operationId": "post_cluster_sdn_route_maps_entries",
  "surface": "pve",
  "resource": "cluster",
  "category": "Cluster",
  "name": "create_route_map_entry",
  "method": "POST",
  "path": "/cluster/sdn/route-maps/entries",
  "description": "Create Route Map entry",
  "writeOperation": true,
  "destructive": false,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "action",
      "type": "string",
      "required": true,
      "description": "Matching policy of a route map entry.",
      "enum": [
        "permit",
        "deny"
      ]
    },
    {
      "name": "call",
      "type": "string",
      "required": false,
      "description": "The SDN route map identifier",
      "format": "pve-sdn-route-map-id",
      "typetext": "<string>"
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has a different digest. This can be used to prevent concurrent modifications.",
      "maxLength": 64,
      "typetext": "<string>"
    },
    {
      "name": "exit-action",
      "type": "string",
      "required": false,
      "format": {
        "key": {
          "enum": [
            "on-match-goto",
            "on-match-next",
            "continue"
          ],
          "type": "string"
        },
        "value": {
          "description": "The index of this route map entry",
          "maximum": 65535,
          "minimum": 0,
          "optional": 1,
          "type": "integer"
        }
      },
      "typetext": "key=<on-match-goto|on-match-next|continue> [,value=<integer>]"
    },
    {
      "name": "lock-token",
      "type": "string",
      "required": false,
      "description": "the token for unlocking the global SDN configuration",
      "typetext": "<string>"
    },
    {
      "name": "match",
      "type": "array",
      "required": false,
      "typetext": "<array>"
    },
    {
      "name": "order",
      "type": "integer",
      "required": true,
      "description": "The index of this route map entry",
      "minimum": 0,
      "maximum": 65535,
      "typetext": "<integer> (0 - 65535)"
    },
    {
      "name": "route-map-id",
      "type": "string",
      "required": true,
      "description": "The SDN route map identifier",
      "format": "pve-sdn-route-map-id",
      "typetext": "<string>"
    },
    {
      "name": "set",
      "type": "array",
      "required": false,
      "typetext": "<array>"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": [
      "perm",
      "/sdn/route-maps",
      [
        "SDN.Allocate"
      ]
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"action\":\"permit\",\"order\":\"0\",\"route-map-id\":\"<route-map-id>\"}' 'https://PVE_HOST:8006/api2/json/cluster/sdn/route-maps/entries'"
}

{
  "operationId": "put_nodes_node_disks_wipedisk",
  "surface": "pve",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "wipe_disk",
  "method": "PUT",
  "path": "/nodes/{node}/disks/wipedisk",
  "description": "Wipe a disk or partition.",
  "writeOperation": true,
  "destructive": true,
  "protected": true,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "The cluster node name.",
      "format": "pve-node",
      "typetext": "<string>"
    }
  ],
  "params": [
    {
      "name": "disk",
      "type": "string",
      "required": true,
      "description": "Block device name",
      "pattern": "^/dev/[a-zA-Z0-9\\/]+$"
    }
  ],
  "returns": {
    "type": "string"
  },
  "permissions": null,
  "requestSample": "curl -k -X PUT -H 'Authorization: PVEAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"disk\":\"<disk>\"}' 'https://PVE_HOST:8006/api2/json/nodes/<node>/disks/wipedisk'"
}

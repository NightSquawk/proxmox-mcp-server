{
  "operationId": "put_config_views_id",
  "surface": "pdm",
  "resource": "config",
  "category": "Configuration",
  "name": "{id}",
  "method": "PUT",
  "path": "/config/views/{id}",
  "description": "Update View.",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "View name.",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    }
  ],
  "params": [
    {
      "name": "delete",
      "type": "array",
      "required": false,
      "description": "List of properties to delete."
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has different SHA256 digest. This can be used to prevent concurrent modifications.",
      "pattern": "/^[a-f0-9]{64}$/"
    },
    {
      "name": "exclude",
      "type": "array",
      "required": false,
      "description": "List of filter rules."
    },
    {
      "name": "include",
      "type": "array",
      "required": false,
      "description": "List of filter rules."
    },
    {
      "name": "include-all",
      "type": "boolean",
      "required": false,
      "description": "Include all resources by default."
    },
    {
      "name": "layout",
      "type": "string",
      "required": false,
      "description": "The configured layout, encoded as json"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "view",
        "{id}"
      ],
      "privs": [
        "Resource.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PDM_HOST:8443/api2/json/config/views/<id>'"
}

{
  "operationId": "get_nodes_node_time",
  "surface": "pdm",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "time",
  "method": "GET",
  "path": "/nodes/{node}/time",
  "description": "Read server time and time zone settings.",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [],
  "returns": {
    "additionalProperties": false,
    "description": "Server time and timezone.",
    "properties": {
      "localtime": {
        "description": "Seconds since 1970-01-01 00:00:00 UTC. (local time)",
        "minimum": 1297163644,
        "type": "integer"
      },
      "time": {
        "description": "Seconds since 1970-01-01 00:00:00 UTC.",
        "minimum": 1297163644,
        "type": "integer"
      },
      "timezone": {
        "description": "Time zone. The file '/usr/share/zoneinfo/zone.tab' contains the list of valid names.",
        "maxLength": 64,
        "minLength": 2,
        "pattern": "/^[[:^cntrl:]]*$/",
        "type": "string"
      }
    },
    "type": "object"
  },
  "permissions": {
    "user": "all"
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/nodes/<node>/time'"
}

{
  "operationId": "put_pve_remotes_remote_lxc_vmid_snapshot_snapname_config",
  "surface": "pdm",
  "resource": "pve",
  "category": "PVE Remotes",
  "name": "config",
  "method": "PUT",
  "path": "/pve/remotes/{remote}/lxc/{vmid}/snapshot/{snapname}/config",
  "description": "Update a remote lxc container snapshot's description. This is synchronous (no worker task).",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "remote",
      "type": "string",
      "required": true,
      "description": "Remote ID.",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "A guest ID",
      "minimum": 1
    },
    {
      "name": "snapname",
      "type": "string",
      "required": true,
      "description": "The name of the snapshot",
      "maxLength": 40,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    }
  ],
  "params": [
    {
      "name": "description",
      "type": "string",
      "required": false,
      "description": "A textual description or comment."
    },
    {
      "name": "node",
      "type": "string",
      "required": false,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "resource",
        "{remote}",
        "guest",
        "{vmid}"
      ],
      "privs": [
        "Resource.Manage"
      ]
    }
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PDM_HOST:8443/api2/json/pve/remotes/<remote>/lxc/0/snapshot/<snapname>/config'"
}

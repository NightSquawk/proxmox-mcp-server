{
  "operationId": "post_subscriptions_revert_pending_clear",
  "surface": "pdm",
  "resource": "subscriptions",
  "category": "Subscriptions",
  "name": "revert-pending-clear",
  "method": "POST",
  "path": "/subscriptions/revert-pending-clear",
  "description": "Drop a queued Clear Key on `remote`/`node` while keeping the binding intact.\n\nBacks out a Queue Clear on a single node without going through the global Discard Pending\npath (which scrubs every pending change in the pool). The binding stays so the operator can\nretry the queueing or leave the live subscription untouched.",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has different SHA256 digest. This can be used to prevent concurrent modifications.",
      "pattern": "/^[a-f0-9]{64}$/"
    },
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    },
    {
      "name": "remote",
      "type": "string",
      "required": true,
      "description": "Remote ID.",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "system"
      ],
      "privs": [
        "System.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"node\":\"<node>\",\"remote\":\"<remote>\"}' 'https://PDM_HOST:8443/api2/json/subscriptions/revert-pending-clear'"
}

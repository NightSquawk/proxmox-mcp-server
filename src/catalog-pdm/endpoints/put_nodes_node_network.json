{
  "operationId": "put_nodes_node_network",
  "surface": "pdm",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "network",
  "method": "PUT",
  "path": "/nodes/{node}/network",
  "description": "Reload network configuration (requires ifupdown2).",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [],
  "returns": {
    "description": "Unique Process/Task Identifier",
    "minLength": 36,
    "pattern": "/^UPID:(?P<node>[a-zA-Z0-9]([a-zA-Z0-9\\-]*[a-zA-Z0-9])?):(?P<pid>[0-9A-Fa-f]{8}):(?P<pstart>[0-9A-Fa-f]{8,9}):(?P<task_id>[0-9A-Fa-f]{8,16}):(?P<starttime>[0-9A-Fa-f]{8}):(?P<wtype>[^:\\s]+):(?P<wid>[^:\\s]*):(?P<authid>[^:\\s]+):$/",
    "type": "string"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "system",
        "network",
        "interfaces"
      ],
      "privs": [
        "System.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PDM_HOST:8443/api2/json/nodes/<node>/network'"
}

{
  "operationId": "put_access_acl",
  "surface": "pdm",
  "resource": "access",
  "category": "Access & Auth",
  "name": "acl",
  "method": "PUT",
  "path": "/access/acl",
  "description": "Update ACL",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "auth-id",
      "type": "string",
      "required": false,
      "description": "Authentication ID",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "/^(?:(?:[^\\s:/[:cntrl:]]+)@(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)|(?:[^\\s:/[:cntrl:]]+)@(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)!(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*))$/"
    },
    {
      "name": "delete",
      "type": "boolean",
      "required": false,
      "description": "Remove permissions (instead of adding it).",
      "default": false
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has different SHA256 digest. This can be used to prevent concurrent modifications.",
      "pattern": "/^[a-f0-9]{64}$/"
    },
    {
      "name": "group",
      "type": "string",
      "required": false,
      "description": "Group ID",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "/^(?:[^\\s:/[:cntrl:]]+)$/"
    },
    {
      "name": "path",
      "type": "string",
      "required": true,
      "description": "Access control path.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "/^(?:/|(?:/(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*))+)$/"
    },
    {
      "name": "propagate",
      "type": "boolean",
      "required": false,
      "description": "Allow to propagate (inherit) permissions.",
      "default": true
    },
    {
      "name": "role",
      "type": "string",
      "required": true,
      "description": "Name of a role that the auth id will be granted."
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "description": "Requires sufficient permissions to edit the ACL, otherwise only editing the current user's API token permissions is allowed.",
    "user": "all"
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"path\":\"<path>\",\"role\":\"<role>\"}' 'https://PDM_HOST:8443/api2/json/access/acl'"
}

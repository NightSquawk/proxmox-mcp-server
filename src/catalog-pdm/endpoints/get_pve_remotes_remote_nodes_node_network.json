{
  "operationId": "get_pve_remotes_remote_nodes_node_network",
  "surface": "pdm",
  "resource": "pve",
  "category": "PVE Remotes",
  "name": "network",
  "method": "GET",
  "path": "/pve/remotes/{remote}/nodes/{node}/network",
  "description": "Get network interfaces from PVE node",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "remote",
      "type": "string",
      "required": true,
      "description": "Remote ID.",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    },
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [
    {
      "name": "interface-type",
      "type": "string",
      "required": false,
      "description": "Only list specific interface types.",
      "enum": [
        "bridge",
        "bond",
        "eth",
        "alias",
        "vlan",
        "fabric",
        "OVSBridge",
        "OVSBond",
        "OVSPort",
        "OVSIntPort",
        "vnet",
        "any_bridge",
        "any_local_bridge",
        "include_sdn"
      ]
    }
  ],
  "returns": {
    "description": "A list of network interfaces of a PVE remote.",
    "items": {
      "additionalProperties": false,
      "description": "Object.",
      "properties": {
        "active": {
          "default": false,
          "description": "Set to true if the interface is active.",
          "optional": 1,
          "type": "boolean"
        },
        "address": {
          "description": "IP address.",
          "optional": 1,
          "type": "string"
        },
        "address6": {
          "description": "IP address.",
          "optional": 1,
          "type": "string"
        },
        "autostart": {
          "default": false,
          "description": "Automatically start interface on boot.",
          "optional": 1,
          "type": "boolean"
        },
        "bond-primary": {
          "description": "Specify the primary interface for active-backup bond.",
          "optional": 1,
          "pattern": "/^[a-zA-Z][a-zA-Z0-9_]{1,20}([:\\.]\\d+)?$/",
          "type": "string"
        },
        "bond_mode": {
          "description": "Bonding mode.",
          "enum": [
            "balance-rr",
            "active-backup",
            "balance-xor",
            "broadcast",
            "802.3ad",
            "balance-tlb",
            "balance-alb",
            "balance-slb",
            "lacp-balance-slb",
            "lacp-balance-tcp"
          ],
          "optional": 1,
          "type": "string"
        },
        "bond_xmit_hash_policy": {
          "description": "Selects the transmit hash policy to use for slave selection in balance-xor\nand 802.3ad modes.",
          "enum": [
            "layer2",
            "layer2+3",
            "layer3+4"
          ],
          "optional": 1,
          "type": "string"
        },
        "bridge-access": {
          "description": "The bridge port access VLAN.",
          "optional": 1,
          "type": "integer"
        },
        "bridge-arp-nd-suppress": {
          "default": false,
          "description": "Bridge port ARP/ND suppress flag.",
          "optional": 1,
          "type": "boolean"
        },
        "bridge-learning": {
          "default": false,
          "description": "Bridge port learning flag.",
          "optional": 1,
          "type": "boolean"
        },
        "bridge-multicast-flood": {
          "default": false,
          "description": "Bridge port multicast flood flag.",
          "optional": 1,
          "type": "boolean"
        },
        "bridge-unicast-flood": {
          "default": false,
          "description": "Bridge port unicast flood flag.",
          "optional": 1,
          "type": "boolean"
        },
        "bridge_ports": {
          "description": "Specify the interfaces you want to add to your bridge.",
          "optional": 1,
          "pattern": "/^[a-zA-Z][a-zA-Z0-9_]{1,20}([:\\.]\\d+)?$/",
          "type": "string"
        },
        "bridge_vids": {
          "description": "Specify the allowed VLANs. For example: '2 4 100-200'. Only used if the\nbridge is VLAN aware.",
          "optional": 1,
          "type": "string"
        },
        "bridge_vlan_aware": {
          "default": false,
          "description": "Enable bridge vlan support.",
          "optional": 1,
          "type": "boolean"
        },
        "cidr": {
          "description": "IPv4 CIDR.",
          "optional": 1,
          "type": "string"
        },
        "cidr6": {
          "description": "IPv6 CIDR.",
          "optional": 1,
          "type": "string"
        },
        "comments": {
          "description": "Comments",
          "optional": 1,
          "type": "string"
        },
        "comments6": {
          "description": "Comments",
          "optional": 1,
          "type": "string"
        },
        "exists": {
          "default": false,
          "description": "Set to true if the interface physically exists.",
          "optional": 1,
          "type": "boolean"
        },
        "families": {
          "description": "The network families.",
          "items": {
            "description": "A network family.",
            "enum": [
              "inet",
              "inet6"
            ],
            "type": "string"
          },
          "optional": 1,
          "type": "array"
        },
        "gateway": {
          "description": "Default gateway address.",
          "optional": 1,
          "type": "string"
        },
        "gateway6": {
          "description": "Default ipv6 gateway address.",
          "optional": 1,
          "type": "string"
        },
        "iface": {
          "description": "Network interface name.",
          "maxLength": 20,
          "minLength": 2,
          "pattern": "/^[a-zA-Z][a-zA-Z0-9_]{1,20}([:\\.]\\d+)?$/",
          "type": "string"
        },
        "link-type": {
          "description": "The link type.",
          "optional": 1,
          "type": "string"
        },
        "method": {
          "description": "The network configuration method for IPv4.",
          "enum": [
            "loopback",
            "dhcp",
            "manual",
            "static",
            "auto"
          ],
          "optional": 1,
          "type": "string"
        },
        "method6": {
          "description": "The network configuration method for IPv4.",
          "enum": [
            "loopback",
            "dhcp",
            "manual",
            "static",
            "auto"
          ],
          "optional": 1,
          "type": "string"
        },
        "mtu": {
          "description": "MTU.",
          "maximum": 65520,
          "minimum": 1280,
          "optional": 1,
          "type": "integer"
        },
        "netmask": {
          "description": "Network mask.",
          "optional": 1,
          "type": "string"
        },
        "netmask6": {
          "description": "Network mask.",
          "maximum": 128,
          "minimum": 0,
          "optional": 1,
          "type": "integer"
        },
        "options": {
          "description": "A list of additional interface options for IPv4.",
          "items": {
            "description": "An interface property.",
            "type": "string"
          },
          "optional": 1,
          "type": "array"
        },
        "options6": {
          "description": "A list of additional interface options for IPv6.",
          "items": {
            "description": "An interface property.",
            "type": "string"
          },
          "optional": 1,
          "type": "array"
        },
        "ovs_bonds": {
          "description": "Specify the interfaces used by the bonding device.",
          "optional": 1,
          "pattern": "/^[a-zA-Z][a-zA-Z0-9_]{1,20}([:\\.]\\d+)?$/",
          "type": "string"
        },
        "ovs_bridge": {
          "description": "The OVS bridge associated with a OVS port. This is required when you\ncreate an OVS port.",
          "optional": 1,
          "pattern": "/^[a-zA-Z][a-zA-Z0-9_]{1,20}([:\\.]\\d+)?$/",
          "type": "string"
        },
        "ovs_options": {
          "description": "OVS interface options.",
          "maxLength": 1024,
          "optional": 1,
          "type": "string"
        },
        "ovs_ports": {
          "description": "Specify the interfaces you want to add to your bridge.",
          "optional": 1,
          "pattern": "/^[a-zA-Z][a-zA-Z0-9_]{1,20}([:\\.]\\d+)?$/",
          "type": "string"
        },
        "ovs_tag": {
          "description": "Specify a VLan tag (used by OVSPort, OVSIntPort, OVSBond)",
          "maximum": 4094,
          "minimum": 1,
          "optional": 1,
          "type": "integer"
        },
        "priority": {
          "description": "The order of the interface.",
          "optional": 1,
          "type": "integer"
        },
        "slaves": {
          "description": "Specify the interfaces used by the bonding device.",
          "optional": 1,
          "pattern": "/^[a-zA-Z][a-zA-Z0-9_]{1,20}([:\\.]\\d+)?$/",
          "type": "string"
        },
        "type": {
          "description": "Network interface type",
          "enum": [
            "bridge",
            "bond",
            "eth",
            "alias",
            "vlan",
            "fabric",
            "OVSBridge",
            "OVSBond",
            "OVSPort",
            "OVSIntPort",
            "vnet",
            "unknown"
          ],
          "type": "string"
        },
        "uplink-id": {
          "description": "The uplink ID.",
          "optional": 1,
          "type": "string"
        },
        "vlan-id": {
          "description": "vlan-id for a custom named vlan interface (ifupdown2 only).",
          "maximum": 4094,
          "minimum": 1,
          "optional": 1,
          "type": "integer"
        },
        "vlan-protocol": {
          "description": "The VLAN protocol.",
          "enum": [
            "802.1ad",
            "802.1q"
          ],
          "optional": 1,
          "type": "string"
        },
        "vlan-raw-device": {
          "description": "Specify the raw interface for the vlan interface.",
          "optional": 1,
          "pattern": "/^[a-zA-Z][a-zA-Z0-9_]{1,20}([:\\.]\\d+)?$/",
          "type": "string"
        },
        "vxlan-id": {
          "description": "The VXLAN ID.",
          "optional": 1,
          "type": "integer"
        },
        "vxlan-local-tunnelip": {
          "description": "The VXLAN local tunnel IP.",
          "optional": 1,
          "type": "string"
        },
        "vxlan-physdev": {
          "description": "The physical device for the VXLAN tunnel.",
          "optional": 1,
          "type": "string"
        },
        "vxlan-svcnodeip": {
          "description": "The VXLAN SVC node IP.",
          "optional": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "resource",
        "{remote}",
        "node",
        "{node}"
      ],
      "privs": [
        "Resource.Audit"
      ]
    }
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/pve/remotes/<remote>/nodes/<node>/network'"
}

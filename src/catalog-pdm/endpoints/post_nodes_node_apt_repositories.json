{
  "operationId": "post_nodes_node_apt_repositories",
  "surface": "pdm",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "repositories",
  "method": "POST",
  "path": "/nodes/{node}/apt/repositories",
  "description": "Change the properties of the specified repository.\n\nThe `digest` parameter asserts that the configuration has not been modified.",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has different SHA256 digest. This can be used to prevent concurrent modifications.",
      "pattern": "/^[a-f0-9]{64}$/"
    },
    {
      "name": "enabled",
      "type": "boolean",
      "required": false,
      "description": "Whether the repository should be enabled or not."
    },
    {
      "name": "index",
      "type": "integer",
      "required": true,
      "description": "Index within the file (starting from 0)."
    },
    {
      "name": "path",
      "type": "string",
      "required": true,
      "description": "Path to the containing file."
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [],
      "privs": [
        "System.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"index\":\"0\",\"path\":\"<path>\"}' 'https://PDM_HOST:8443/api2/json/nodes/<node>/apt/repositories'"
}

{
  "operationId": "get_nodes_node_report",
  "surface": "pdm",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "report",
  "method": "GET",
  "path": "/nodes/{node}/report",
  "description": "Get the system report for this node.",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [],
  "returns": {
    "description": "The system report for this PDM node.",
    "type": "string"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "system",
        "status"
      ],
      "privs": [
        "System.Audit"
      ]
    }
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/nodes/<node>/report'"
}

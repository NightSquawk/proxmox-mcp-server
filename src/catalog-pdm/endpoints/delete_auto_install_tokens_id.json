{
  "operationId": "delete_auto_install_tokens_id",
  "surface": "pdm",
  "resource": "auto-install",
  "category": "Auto Install",
  "name": "{id}",
  "method": "DELETE",
  "path": "/auto-install/tokens/{id}",
  "description": "DELETE /auto-install/tokens/{id}\n\nDeletes a prepared auto-installer answer configuration.\n\nIf the token is currently in use by any prepared answer configuration, the deletion will fail.",
  "writeOperation": true,
  "destructive": true,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "API Token name",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    }
  ],
  "params": [],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "system",
        "auto-installation"
      ],
      "privs": [
        "System.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X DELETE -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/auto-install/tokens/<id>'"
}

{
  "operationId": "delete_auto_install_installations_uuid",
  "surface": "pdm",
  "resource": "auto-install",
  "category": "Auto Install",
  "name": "{uuid}",
  "method": "DELETE",
  "path": "/auto-install/installations/{uuid}",
  "description": "DELETE /auto-install/installations/{uuid}\n\nRemove an installation entry.",
  "writeOperation": true,
  "destructive": true,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "uuid",
      "type": "string",
      "required": true,
      "description": "UUID of a installation.",
      "pattern": "/^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/"
    }
  ],
  "params": [],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "system",
        "auto-installation"
      ],
      "privs": [
        "System.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X DELETE -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/auto-install/installations/<uuid>'"
}

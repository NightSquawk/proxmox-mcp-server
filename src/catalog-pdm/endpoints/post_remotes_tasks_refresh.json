{
  "operationId": "post_remotes_tasks_refresh",
  "surface": "pdm",
  "resource": "remotes",
  "category": "Remotes",
  "name": "refresh",
  "method": "POST",
  "path": "/remotes/tasks/refresh",
  "description": "Refresh remote tasks cache.\n\nIf `remotes` is provided, tasks will only be fetched from the provided remotes.\n`Resource.Modify` permissions on `/resource/{remote}` are needed for every remote provided this way.\n\nIf `remotes` is not provided, then all remotes for which the user has appropriate permissions are considered.",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "remotes",
      "type": "array",
      "required": false,
      "description": "Optional list of tasks to fetch tasks from."
    }
  ],
  "returns": {
    "description": "Unique Process/Task Identifier",
    "minLength": 36,
    "pattern": "/^UPID:(?P<node>[a-zA-Z0-9]([a-zA-Z0-9\\-]*[a-zA-Z0-9])?):(?P<pid>[0-9A-Fa-f]{8}):(?P<pstart>[0-9A-Fa-f]{8,9}):(?P<task_id>[0-9A-Fa-f]{8,16}):(?P<starttime>[0-9A-Fa-f]{8}):(?P<wtype>[^:\\s]+):(?P<wid>[^:\\s]*):(?P<authid>[^:\\s]+):$/",
    "type": "string"
  },
  "permissions": {
    "description": "Resource.Modify privileges are needed on /resource/{remote}",
    "user": "all"
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PDM_HOST:8443/api2/json/remotes/tasks/refresh'"
}

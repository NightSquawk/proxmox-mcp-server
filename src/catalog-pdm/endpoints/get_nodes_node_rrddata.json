{
  "operationId": "get_nodes_node_rrddata",
  "surface": "pdm",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "rrddata",
  "method": "GET",
  "path": "/nodes/{node}/rrddata",
  "description": "Read RRD data for this PDM node.",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [
    {
      "name": "cf",
      "type": "string",
      "required": true,
      "description": "RRD consolidation mode",
      "enum": [
        "MAX",
        "AVERAGE"
      ]
    },
    {
      "name": "timeframe",
      "type": "string",
      "required": true,
      "description": "RRD time frame",
      "enum": [
        "hour",
        "day",
        "week",
        "month",
        "year",
        "decade"
      ]
    }
  ],
  "returns": {
    "description": "An array of RRD data points.",
    "items": {
      "additionalProperties": false,
      "description": "RRD datapoint for statistics about the metric collection loop.",
      "properties": {
        "cpu-avg1": {
          "description": "CPU utilization, averaged over the last minute",
          "optional": 1,
          "type": "number"
        },
        "cpu-avg15": {
          "description": "CPU utilization, averaged over the last fifteen minutes",
          "optional": 1,
          "type": "number"
        },
        "cpu-avg5": {
          "description": "CPU utilization, averaged over the last five minutes",
          "optional": 1,
          "type": "number"
        },
        "cpu-current": {
          "description": "Current CPU utilization",
          "optional": 1,
          "type": "number"
        },
        "cpu-iowait": {
          "description": "Current IO wait",
          "optional": 1,
          "type": "number"
        },
        "cpu-pressure-some-avg10": {
          "description": "Average 'some' CPU pressure over the last 10 minutes.",
          "optional": 1,
          "type": "number"
        },
        "disk-io-ticks": {
          "description": "Root disk IO ticks",
          "optional": 1,
          "type": "number"
        },
        "disk-read": {
          "description": "Root disk read rate",
          "optional": 1,
          "type": "number"
        },
        "disk-read-iops": {
          "description": "Root disk read IOPS",
          "optional": 1,
          "type": "number"
        },
        "disk-total": {
          "description": "Total root disk size",
          "optional": 1,
          "type": "number"
        },
        "disk-used": {
          "description": "Total root disk usage",
          "optional": 1,
          "type": "number"
        },
        "disk-write": {
          "description": "Root disk write rate",
          "optional": 1,
          "type": "number"
        },
        "disk-write-iops": {
          "description": "Root disk write IOPS",
          "optional": 1,
          "type": "number"
        },
        "io-pressure-full-avg10": {
          "description": "Average 'full' IO pressure over the last 10 minutes.",
          "optional": 1,
          "type": "number"
        },
        "io-pressure-some-avg10": {
          "description": "Average 'some' IO pressure over the last 10 minutes.",
          "optional": 1,
          "type": "number"
        },
        "mem-pressure-full-avg10": {
          "description": "Average 'full' memory pressure over the last 10 minutes.",
          "optional": 1,
          "type": "number"
        },
        "mem-pressure-some-avg10": {
          "description": "Average 'some' memory pressure over the last 10 minutes.",
          "optional": 1,
          "type": "number"
        },
        "mem-total": {
          "description": "Total memory size",
          "optional": 1,
          "type": "number"
        },
        "mem-used": {
          "description": "Currently used memory",
          "optional": 1,
          "type": "number"
        },
        "metric-collection-total-time": {
          "description": "Total time in milliseconds needed for full metric collection run.",
          "optional": 1,
          "type": "number"
        },
        "net-in": {
          "description": "Inbound network data rate",
          "optional": 1,
          "type": "number"
        },
        "net-out": {
          "description": "Outbound network data rate",
          "optional": 1,
          "type": "number"
        },
        "swap-total": {
          "description": "Total swap size",
          "optional": 1,
          "type": "number"
        },
        "swap-used": {
          "description": "Current swap usage",
          "optional": 1,
          "type": "number"
        },
        "time": {
          "description": "Timestamp (UNIX epoch)",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": null,
  "requestSample": "curl -k -X GET -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/nodes/<node>/rrddata?cf=MAX&timeframe=hour'"
}

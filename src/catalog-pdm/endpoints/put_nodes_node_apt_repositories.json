{
  "operationId": "put_nodes_node_apt_repositories",
  "surface": "pdm",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "repositories",
  "method": "PUT",
  "path": "/nodes/{node}/apt/repositories",
  "description": "Add the repository identified by the `handle`.\nIf the repository is already configured, it will be set to enabled.\n\nThe `digest` parameter asserts that the configuration has not been modified.",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has different SHA256 digest. This can be used to prevent concurrent modifications.",
      "pattern": "/^[a-f0-9]{64}$/"
    },
    {
      "name": "handle",
      "type": "string",
      "required": true,
      "description": "Handle referencing a standard APT repository.",
      "pattern": "/^[a-z][a-z0-9]*(-[a-z0-9]+)*$/"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [],
      "privs": [
        "System.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"handle\":\"<handle>\"}' 'https://PDM_HOST:8443/api2/json/nodes/<node>/apt/repositories'"
}

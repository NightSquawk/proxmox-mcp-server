{
  "operationId": "get_nodes_node_config",
  "surface": "pdm",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "config",
  "method": "GET",
  "path": "/nodes/{node}/config",
  "description": "Get the node configuration",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [],
  "returns": {
    "additionalProperties": false,
    "description": "Node specific configuration.",
    "properties": {
      "ciphers-tls-1.2": {
        "description": "OpenSSL cipher list used by the api server for TLS <= 1.2",
        "optional": 1,
        "pattern": "/^[0-9A-Za-z_:, +!\\-@=.]+$/",
        "type": "string"
      },
      "ciphers-tls-1.3": {
        "description": "OpenSSL ciphersuites list used by the api server for TLS 1.3",
        "optional": 1,
        "pattern": "/^[0-9A-Za-z_:, +!\\-@=.]+$/",
        "type": "string"
      },
      "default-lang": {
        "description": "All available languages in Proxmox. Taken from proxmox-i18n repository.\npt_BR, zh_CN, and zh_TW use the same case in the translation files.",
        "enum": [
          "ar",
          "ca",
          "da",
          "de",
          "en",
          "es",
          "eu",
          "fa",
          "fr",
          "gl",
          "he",
          "hu",
          "it",
          "ja",
          "kr",
          "nb",
          "nl",
          "nn",
          "pl",
          "pt_BR",
          "ru",
          "sl",
          "sv",
          "tr",
          "zh_CN",
          "zh_TW"
        ],
        "optional": 1,
        "type": "string"
      },
      "email-from": {
        "description": "E-Mail Address.",
        "maxLength": 64,
        "minLength": 2,
        "optional": 1,
        "pattern": "/^[[:^cntrl:]]*$/",
        "type": "string"
      },
      "http-proxy": {
        "description": "HTTP proxy configuration [http://]<host>[:port]",
        "maxLength": 128,
        "minLength": 1,
        "optional": 1,
        "type": "string",
        "typetext": "[http://]<host>[:port]"
      }
    },
    "type": "object"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "system"
      ],
      "privs": [
        "System.Audit"
      ]
    }
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/nodes/<node>/config'"
}

{
  "operationId": "post_pve_remotes_remote_lxc_vmid_migrate",
  "surface": "pdm",
  "resource": "pve",
  "category": "PVE Remotes",
  "name": "migrate",
  "method": "POST",
  "path": "/pve/remotes/{remote}/lxc/{vmid}/migrate",
  "description": "Perform an in-cluster migration of a VM.",
  "writeOperation": true,
  "destructive": true,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "remote",
      "type": "string",
      "required": true,
      "description": "Remote ID.",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "A guest ID",
      "minimum": 1
    }
  ],
  "params": [
    {
      "name": "bwlimit",
      "type": "integer",
      "required": false,
      "description": "Override I/O bandwidth limit (in KiB/s).",
      "minimum": 0
    },
    {
      "name": "node",
      "type": "string",
      "required": false,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    },
    {
      "name": "online",
      "type": "boolean",
      "required": false,
      "description": "Attempt an online migration if the container is running."
    },
    {
      "name": "restart",
      "type": "boolean",
      "required": false,
      "description": "Perform a restart-migration if the container is running."
    },
    {
      "name": "target",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    },
    {
      "name": "target-storage",
      "type": "array",
      "required": false,
      "description": "List of storage mappings"
    },
    {
      "name": "timeout",
      "type": "integer",
      "required": false,
      "description": "Shutdown timeout for restart-migrations."
    }
  ],
  "returns": {
    "description": "A remote UPID",
    "minLength": 42,
    "type": "string"
  },
  "permissions": {
    "and": [
      {
        "check": {
          "partial": false,
          "path": [
            "resource",
            "{remote}",
            "guest",
            "{vmid}"
          ],
          "privs": [
            "Resource.Migrate"
          ]
        }
      }
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"target\":\"<target>\"}' 'https://PDM_HOST:8443/api2/json/pve/remotes/<remote>/lxc/0/migrate'"
}

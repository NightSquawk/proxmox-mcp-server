{
  "operationId": "put_nodes_node_config",
  "surface": "pdm",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "config",
  "method": "PUT",
  "path": "/nodes/{node}/config",
  "description": "Update the node configuration",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [
    {
      "name": "ciphers-tls-1.2",
      "type": "string",
      "required": false,
      "description": "OpenSSL cipher list used by the api server for TLS <= 1.2",
      "pattern": "/^[0-9A-Za-z_:, +!\\-@=.]+$/"
    },
    {
      "name": "ciphers-tls-1.3",
      "type": "string",
      "required": false,
      "description": "OpenSSL ciphersuites list used by the api server for TLS 1.3",
      "pattern": "/^[0-9A-Za-z_:, +!\\-@=.]+$/"
    },
    {
      "name": "default-lang",
      "type": "string",
      "required": false,
      "description": "All available languages in Proxmox. Taken from proxmox-i18n repository.\npt_BR, zh_CN, and zh_TW use the same case in the translation files.",
      "enum": [
        "ar",
        "ca",
        "da",
        "de",
        "en",
        "es",
        "eu",
        "fa",
        "fr",
        "gl",
        "he",
        "hu",
        "it",
        "ja",
        "kr",
        "nb",
        "nl",
        "nn",
        "pl",
        "pt_BR",
        "ru",
        "sl",
        "sv",
        "tr",
        "zh_CN",
        "zh_TW"
      ]
    },
    {
      "name": "delete",
      "type": "array",
      "required": false,
      "description": "List of properties to delete."
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has different SHA256 digest. This can be used to prevent concurrent modifications.",
      "pattern": "/^[a-f0-9]{64}$/"
    },
    {
      "name": "email-from",
      "type": "string",
      "required": false,
      "description": "E-Mail Address.",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "/^[[:^cntrl:]]*$/"
    },
    {
      "name": "http-proxy",
      "type": "string",
      "required": false,
      "description": "HTTP proxy configuration [http://]<host>[:port]",
      "minLength": 1,
      "maxLength": 128,
      "typetext": "[http://]<host>[:port]"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "system"
      ],
      "privs": [
        "System.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PDM_HOST:8443/api2/json/nodes/<node>/config'"
}

{
  "operationId": "get_pve_remotes_remote_nodes_node_firewall_status",
  "surface": "pdm",
  "resource": "pve",
  "category": "PVE Remotes",
  "name": "status",
  "method": "GET",
  "path": "/pve/remotes/{remote}/nodes/{node}/firewall/status",
  "description": "Get firewall status of a specific node.",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "remote",
      "type": "string",
      "required": true,
      "description": "Remote ID.",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    },
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [],
  "returns": {
    "additionalProperties": false,
    "description": "Firewall status of a node",
    "properties": {
      "guests": {
        "description": "Guests on a node",
        "items": {
          "additionalProperties": false,
          "description": "Firewall status of a guest",
          "properties": {
            "kind": {
              "description": "The type of the guest",
              "enum": [
                "lxc",
                "qemu"
              ],
              "type": "string"
            },
            "name": {
              "description": "Name of the guest.",
              "type": "string"
            },
            "status": {
              "additionalProperties": false,
              "description": "Firewall status.",
              "optional": 1,
              "properties": {
                "active": {
                  "description": "The amount of enabled rules",
                  "minimum": 0,
                  "type": "integer"
                },
                "all": {
                  "description": "The total amount of rules present",
                  "minimum": 0,
                  "type": "integer"
                },
                "enabled": {
                  "description": "True if the firewall is enabled",
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "vmid": {
              "description": "A guest ID",
              "minimum": 1,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "type": "array"
      },
      "node": {
        "description": "Node name (or 'localhost')",
        "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/",
        "type": "string"
      },
      "status": {
        "additionalProperties": false,
        "description": "Firewall status.",
        "optional": 1,
        "properties": {
          "active": {
            "description": "The amount of enabled rules",
            "minimum": 0,
            "type": "integer"
          },
          "all": {
            "description": "The total amount of rules present",
            "minimum": 0,
            "type": "integer"
          },
          "enabled": {
            "description": "True if the firewall is enabled",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    },
    "type": "object"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "resource",
        "{remote}"
      ],
      "privs": [
        "Resource.Audit"
      ]
    }
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/pve/remotes/<remote>/nodes/<node>/firewall/status'"
}

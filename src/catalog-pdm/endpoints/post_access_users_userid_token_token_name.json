{
  "operationId": "post_access_users_userid_token_token_name",
  "surface": "pdm",
  "resource": "access",
  "category": "Access & Auth",
  "name": "{token-name}",
  "method": "POST",
  "path": "/access/users/{userid}/token/{token-name}",
  "description": "Generate a new API token with given metadata",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "userid",
      "type": "string",
      "required": true,
      "description": "User ID",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "/^(?:[^\\s:/[:cntrl:]]+)@(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    },
    {
      "name": "token-name",
      "type": "string",
      "required": true,
      "description": "The token ID part of an API token authentication id.\n\nThis alone does NOT uniquely identify the API token - use a full `Authid` for such use cases.",
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    }
  ],
  "params": [
    {
      "name": "comment",
      "type": "string",
      "required": false,
      "description": "Comment.",
      "maxLength": 128,
      "pattern": "/^[[:^cntrl:]]*$/"
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has different SHA256 digest. This can be used to prevent concurrent modifications.",
      "pattern": "/^[a-f0-9]{64}$/"
    },
    {
      "name": "enable",
      "type": "boolean",
      "required": false,
      "description": "Enable the account (default). You can set this to '0' to disable the account.",
      "default": true
    },
    {
      "name": "expire",
      "type": "integer",
      "required": false,
      "description": "Account expiration date (seconds since epoch). '0' means no expiration date.",
      "default": 0,
      "minimum": 0
    }
  ],
  "returns": {
    "additionalProperties": false,
    "description": "ApiToken id / secret pair",
    "properties": {
      "tokenid": {
        "description": "Authentication ID",
        "maxLength": 64,
        "minLength": 3,
        "pattern": "/^(?:(?:[^\\s:/[:cntrl:]]+)@(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)|(?:[^\\s:/[:cntrl:]]+)@(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)!(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*))$/",
        "type": "string"
      },
      "value": {
        "description": "The secret associated with the token.",
        "type": "string"
      }
    },
    "type": "object"
  },
  "permissions": {
    "or": [
      {
        "check": {
          "partial": false,
          "path": [
            "access",
            "users"
          ],
          "privs": [
            "Access.Modify"
          ]
        }
      },
      {
        "userParam": "userid"
      }
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PDM_HOST:8443/api2/json/access/users/<userid>/token/<token-name>'"
}

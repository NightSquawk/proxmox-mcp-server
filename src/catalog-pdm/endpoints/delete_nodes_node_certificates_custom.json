{
  "operationId": "delete_nodes_node_certificates_custom",
  "surface": "pdm",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "custom",
  "method": "DELETE",
  "path": "/nodes/{node}/certificates/custom",
  "description": "Delete the current certificate and regenerate a self signed one.",
  "writeOperation": true,
  "destructive": true,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [
    {
      "name": "restart",
      "type": "boolean",
      "required": false,
      "description": "UI compatibility parameter, ignored",
      "default": false
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "system",
        "certificates"
      ],
      "privs": [
        "System.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X DELETE -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/nodes/<node>/certificates/custom'"
}

{
  "operationId": "get_nodes_node_syslog",
  "surface": "pdm",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "syslog",
  "method": "GET",
  "path": "/nodes/{node}/syslog",
  "description": "Read syslog entries.",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [
    {
      "name": "limit",
      "type": "integer",
      "required": false,
      "description": "Max. number of lines.",
      "minimum": 0
    },
    {
      "name": "service",
      "type": "string",
      "required": false,
      "description": "Service ID.",
      "maxLength": 128
    },
    {
      "name": "since",
      "type": "string",
      "required": false,
      "description": "Display all log since this date-time string.",
      "pattern": "/^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2}(:\\d{2})?)?$/"
    },
    {
      "name": "start",
      "type": "integer",
      "required": false,
      "description": "Start line number.",
      "minimum": 0
    },
    {
      "name": "until",
      "type": "string",
      "required": false,
      "description": "Display all log until this date-time string.",
      "pattern": "/^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2}(:\\d{2})?)?$/"
    }
  ],
  "returns": {
    "description": "Returns a list of syslog entries.",
    "items": {
      "additionalProperties": false,
      "description": "Syslog line with line number.",
      "properties": {
        "n": {
          "description": "Line number.",
          "minimum": 0,
          "type": "integer"
        },
        "t": {
          "description": "Line text.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "system",
        "log"
      ],
      "privs": [
        "System.Audit"
      ]
    }
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/nodes/<node>/syslog'"
}

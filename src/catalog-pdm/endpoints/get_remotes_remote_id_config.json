{
  "operationId": "get_remotes_remote_id_config",
  "surface": "pdm",
  "resource": "remotes",
  "category": "Remotes",
  "name": "config",
  "method": "GET",
  "path": "/remotes/remote/{id}/config",
  "description": "Get the Remote Configuration",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "Remote ID.",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    }
  ],
  "params": [],
  "returns": {
    "additionalProperties": false,
    "description": "The information required to connect to a remote instance.",
    "properties": {
      "authid": {
        "description": "Authentication ID",
        "maxLength": 64,
        "minLength": 3,
        "pattern": "/^(?:(?:[^\\s:/[:cntrl:]]+)@(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)|(?:[^\\s:/[:cntrl:]]+)@(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)!(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*))$/",
        "type": "string"
      },
      "id": {
        "description": "Remote ID.",
        "maxLength": 32,
        "minLength": 2,
        "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/",
        "type": "string"
      },
      "nodes": {
        "description": "A list of cluster node addresses.",
        "items": {
          "description": "A cluster node IP or hostname.",
          "type": "string"
        },
        "type": "array"
      },
      "token": {
        "description": "The access token's secret.",
        "type": "string"
      },
      "type": {
        "default": "pve",
        "description": "The type of a remote entry.",
        "enum": [
          "pve",
          "pbs"
        ],
        "type": "string"
      },
      "web-url": {
        "description": "Configuration for the Web UI URL link generation.",
        "optional": 1,
        "type": "string"
      }
    },
    "type": "object"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "resource",
        "{id}"
      ],
      "privs": [
        "Resource.Audit"
      ]
    }
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/remotes/remote/<id>/config'"
}

{
  "operationId": "get_resources_subscription",
  "surface": "pdm",
  "resource": "resources",
  "category": "Resources",
  "name": "subscription",
  "method": "GET",
  "path": "/resources/subscription",
  "description": "Returns the subscription status of the remotes",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [],
  "params": [
    {
      "name": "max-age",
      "type": "integer",
      "required": false,
      "description": "Maximum age (in seconds) of cached remote subscription state.",
      "default": 86400,
      "minimum": 0
    },
    {
      "name": "verbose",
      "type": "boolean",
      "required": false,
      "description": "If true, includes subscription information per node (with enough privileges)",
      "default": false
    },
    {
      "name": "view",
      "type": "string",
      "required": false,
      "description": "View name.",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    }
  ],
  "returns": {
    "description": "Subscription state for each remote.",
    "items": {
      "additionalProperties": false,
      "description": "Lists the subscription level per node for the remote",
      "properties": {
        "error": {
          "description": "Any error that occurred when querying remote resources",
          "optional": 1,
          "type": "string"
        },
        "node-status": {
          "additionalProperties": true,
          "description": "A map from nodename to subscription info",
          "optional": 1,
          "properties": {},
          "type": "object"
        },
        "remote": {
          "description": "Remote name",
          "type": "string"
        },
        "state": {
          "default": "none",
          "description": "Describes the state of subscription of the remote",
          "enum": [
            "none",
            "unknown",
            "mixed",
            "active"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": {
    "user": "all"
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/resources/subscription'"
}

{
  "operationId": "post_nodes_node_status",
  "surface": "pdm",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "status",
  "method": "POST",
  "path": "/nodes/{node}/status",
  "description": "Reboot or shutdown the node.",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [
    {
      "name": "command",
      "type": "string",
      "required": true,
      "description": "Node Power command type.",
      "enum": [
        "reboot",
        "shutdown"
      ]
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "system",
        "status"
      ],
      "privs": [
        "Sys.PowerManagement"
      ]
    }
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"command\":\"reboot\"}' 'https://PDM_HOST:8443/api2/json/nodes/<node>/status'"
}

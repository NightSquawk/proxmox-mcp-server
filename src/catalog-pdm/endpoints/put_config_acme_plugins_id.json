{
  "operationId": "put_config_acme_plugins_id",
  "surface": "pdm",
  "resource": "config",
  "category": "Configuration",
  "name": "{id}",
  "method": "PUT",
  "path": "/config/acme/plugins/{id}",
  "description": "Update an ACME plugin configuration.",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "ACME Challenge Plugin ID.",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    }
  ],
  "params": [
    {
      "name": "api",
      "type": "string",
      "required": false,
      "description": "DNS API Plugin Id."
    },
    {
      "name": "data",
      "type": "string",
      "required": false,
      "description": "DNS plugin data (base64 encoded with padding)."
    },
    {
      "name": "delete",
      "type": "array",
      "required": false,
      "description": "List of properties to delete."
    },
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has different SHA256 digest. This can be used to prevent concurrent modifications.",
      "pattern": "/^[a-f0-9]{64}$/"
    },
    {
      "name": "disable",
      "type": "boolean",
      "required": false,
      "description": "Flag to disable the config.",
      "default": false
    },
    {
      "name": "validation-delay",
      "type": "integer",
      "required": false,
      "description": "Extra delay in seconds to wait before requesting validation.\n\nAllows to cope with long TTL of DNS records.",
      "default": 30,
      "minimum": 0,
      "maximum": 172800
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "system",
        "certificates"
      ],
      "privs": [
        "System.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PDM_HOST:8443/api2/json/config/acme/plugins/<id>'"
}

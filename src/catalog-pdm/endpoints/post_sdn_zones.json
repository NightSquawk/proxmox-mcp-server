{
  "operationId": "post_sdn_zones",
  "surface": "pdm",
  "resource": "sdn",
  "category": "SDN",
  "name": "zones",
  "method": "POST",
  "path": "/sdn/zones",
  "description": "Create a zone across multiple remotes",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "remotes",
      "type": "array",
      "required": true,
      "description": "List of remotes with their controller where zone should get created."
    },
    {
      "name": "vrf-vxlan",
      "type": "integer",
      "required": false,
      "description": "VXLAN VNI",
      "minimum": 1,
      "maximum": 16777215
    },
    {
      "name": "zone",
      "type": "string",
      "required": true,
      "description": "The name for an SDN object (zone / vnet / fabric)."
    }
  ],
  "returns": {
    "description": "Unique Process/Task Identifier",
    "minLength": 36,
    "pattern": "/^UPID:(?P<node>[a-zA-Z0-9]([a-zA-Z0-9\\-]*[a-zA-Z0-9])?):(?P<pid>[0-9A-Fa-f]{8}):(?P<pstart>[0-9A-Fa-f]{8,9}):(?P<task_id>[0-9A-Fa-f]{8,16}):(?P<starttime>[0-9A-Fa-f]{8}):(?P<wtype>[^:\\s]+):(?P<wid>[^:\\s]*):(?P<authid>[^:\\s]+):$/",
    "type": "string"
  },
  "permissions": null,
  "requestSample": "curl -k -X POST -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"remotes\":\"<remotes>\",\"zone\":\"<zone>\"}' 'https://PDM_HOST:8443/api2/json/sdn/zones'"
}

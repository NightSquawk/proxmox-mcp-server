{
  "operationId": "post_pve_remotes_remote_qemu_vmid_stop",
  "surface": "pdm",
  "resource": "pve",
  "category": "PVE Remotes",
  "name": "stop",
  "method": "POST",
  "path": "/pve/remotes/{remote}/qemu/{vmid}/stop",
  "description": "Stop a remote qemu vm.",
  "writeOperation": true,
  "destructive": true,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "remote",
      "type": "string",
      "required": true,
      "description": "Remote ID.",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    },
    {
      "name": "vmid",
      "type": "integer",
      "required": true,
      "description": "A guest ID",
      "minimum": 1
    }
  ],
  "params": [
    {
      "name": "node",
      "type": "string",
      "required": false,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "returns": {
    "description": "A remote UPID",
    "minLength": 42,
    "type": "string"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "resource",
        "{remote}",
        "guest",
        "{vmid}"
      ],
      "privs": [
        "Resource.Manage"
      ]
    }
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PDM_HOST:8443/api2/json/pve/remotes/<remote>/qemu/0/stop'"
}

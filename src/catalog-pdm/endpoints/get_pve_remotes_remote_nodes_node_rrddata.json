{
  "operationId": "get_pve_remotes_remote_nodes_node_rrddata",
  "surface": "pdm",
  "resource": "pve",
  "category": "PVE Remotes",
  "name": "rrddata",
  "method": "GET",
  "path": "/pve/remotes/{remote}/nodes/{node}/rrddata",
  "description": "Read node stats",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "remote",
      "type": "string",
      "required": true,
      "description": "Remote ID.",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    },
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [
    {
      "name": "cf",
      "type": "string",
      "required": true,
      "description": "RRD consolidation mode",
      "enum": [
        "MAX",
        "AVERAGE"
      ]
    },
    {
      "name": "timeframe",
      "type": "string",
      "required": true,
      "description": "RRD time frame",
      "enum": [
        "hour",
        "day",
        "week",
        "month",
        "year",
        "decade"
      ]
    }
  ],
  "returns": {
    "description": "A list of RRD data points for a PVE node.",
    "items": {
      "additionalProperties": false,
      "description": "Single point in time with all known data points for a PVE host.",
      "properties": {
        "cpu-avg1": {
          "description": "CPU utilization, averaged over the last minute",
          "optional": 1,
          "type": "number"
        },
        "cpu-avg15": {
          "description": "CPU utilization, averaged over the last fifteen minutes",
          "optional": 1,
          "type": "number"
        },
        "cpu-avg5": {
          "description": "CPU utilization, averaged over the last five minutes",
          "optional": 1,
          "type": "number"
        },
        "cpu-current": {
          "description": "Current CPU utilization",
          "optional": 1,
          "type": "number"
        },
        "cpu-iowait": {
          "description": "Current IO wait",
          "optional": 1,
          "type": "number"
        },
        "cpu-max": {
          "description": "Max CPU utiliziation (Number of cores)",
          "optional": 1,
          "type": "number"
        },
        "disk-total": {
          "description": "Total disk size",
          "optional": 1,
          "type": "number"
        },
        "disk-used": {
          "description": "Disk utiliziation",
          "optional": 1,
          "type": "number"
        },
        "mem-total": {
          "description": "Total memory size",
          "optional": 1,
          "type": "number"
        },
        "mem-used": {
          "description": "Currently used memory",
          "optional": 1,
          "type": "number"
        },
        "net-in": {
          "description": "Inbound network data rate",
          "optional": 1,
          "type": "number"
        },
        "net-out": {
          "description": "Outboud network data rate",
          "optional": 1,
          "type": "number"
        },
        "swap-total": {
          "description": "Total swap size",
          "optional": 1,
          "type": "number"
        },
        "swap-used": {
          "description": "Currently used swap",
          "optional": 1,
          "type": "number"
        },
        "time": {
          "description": "Timestamp (UNIX epoch)",
          "minimum": 0,
          "type": "integer"
        },
        "uptime": {
          "description": "Container uptime",
          "optional": 1,
          "type": "number"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "resource",
        "{remote}",
        "node",
        "{node}"
      ],
      "privs": [
        "Resource.Audit"
      ]
    }
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/pve/remotes/<remote>/nodes/<node>/rrddata?cf=MAX&timeframe=hour'"
}

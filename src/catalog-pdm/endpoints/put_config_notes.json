{
  "operationId": "put_config_notes",
  "surface": "pdm",
  "resource": "config",
  "category": "Configuration",
  "name": "notes",
  "method": "PUT",
  "path": "/config/notes",
  "description": "Update Notes",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [],
  "params": [
    {
      "name": "digest",
      "type": "string",
      "required": false,
      "description": "Prevent changes if current configuration file has different SHA256 digest. This can be used to prevent concurrent modifications.",
      "pattern": "/^[a-f0-9]{64}$/"
    },
    {
      "name": "notes",
      "type": "string",
      "required": true,
      "description": "New notes text."
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "system",
        "notes"
      ],
      "privs": [
        "System.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"notes\":\"<notes>\"}' 'https://PDM_HOST:8443/api2/json/config/notes'"
}

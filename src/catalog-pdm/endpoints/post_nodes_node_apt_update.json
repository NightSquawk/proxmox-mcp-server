{
  "operationId": "post_nodes_node_apt_update",
  "surface": "pdm",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "update",
  "method": "POST",
  "path": "/nodes/{node}/apt/update",
  "description": "Update the APT database",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [
    {
      "name": "notify",
      "type": "boolean",
      "required": false,
      "description": "Send notification mail about new package updates available to the email\naddress configured for 'root@pam').",
      "default": false
    },
    {
      "name": "quiet",
      "type": "boolean",
      "required": false,
      "description": "Only produces output suitable for logging, omitting progress indicators.",
      "default": false
    }
  ],
  "returns": {
    "description": "Unique Process/Task Identifier",
    "minLength": 36,
    "pattern": "/^UPID:(?P<node>[a-zA-Z0-9]([a-zA-Z0-9\\-]*[a-zA-Z0-9])?):(?P<pid>[0-9A-Fa-f]{8}):(?P<pstart>[0-9A-Fa-f]{8,9}):(?P<task_id>[0-9A-Fa-f]{8,16}):(?P<starttime>[0-9A-Fa-f]{8}):(?P<wtype>[^:\\s]+):(?P<wid>[^:\\s]*):(?P<authid>[^:\\s]+):$/",
    "type": "string"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [],
      "privs": [
        "System.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PDM_HOST:8443/api2/json/nodes/<node>/apt/update'"
}

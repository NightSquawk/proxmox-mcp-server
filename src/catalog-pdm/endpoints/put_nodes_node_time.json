{
  "operationId": "put_nodes_node_time",
  "surface": "pdm",
  "resource": "nodes",
  "category": "Nodes & Guests",
  "name": "time",
  "method": "PUT",
  "path": "/nodes/{node}/time",
  "description": "Set time zone",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [
    {
      "name": "timezone",
      "type": "string",
      "required": true,
      "description": "Time zone. The file '/usr/share/zoneinfo/zone.tab' contains the list of valid names.",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "/^[[:^cntrl:]]*$/"
    }
  ],
  "returns": {
    "type": "null"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "system",
        "time"
      ],
      "privs": [
        "System.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X PUT -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"timezone\":\"<timezone>\"}' 'https://PDM_HOST:8443/api2/json/nodes/<node>/time'"
}

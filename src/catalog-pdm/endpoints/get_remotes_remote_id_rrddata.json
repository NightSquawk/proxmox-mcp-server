{
  "operationId": "get_remotes_remote_id_rrddata",
  "surface": "pdm",
  "resource": "remotes",
  "category": "Remotes",
  "name": "rrddata",
  "method": "GET",
  "path": "/remotes/remote/{id}/rrddata",
  "description": "Read metric collection RRD data.",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "id",
      "type": "string",
      "required": true,
      "description": "Remote ID.",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    }
  ],
  "params": [
    {
      "name": "cf",
      "type": "string",
      "required": true,
      "description": "RRD consolidation mode",
      "enum": [
        "MAX",
        "AVERAGE"
      ]
    },
    {
      "name": "timeframe",
      "type": "string",
      "required": true,
      "description": "RRD time frame",
      "enum": [
        "hour",
        "day",
        "week",
        "month",
        "year",
        "decade"
      ]
    }
  ],
  "returns": {
    "description": "A list remote RRD data points.",
    "items": {
      "additionalProperties": false,
      "description": "RRD datapoint for a single remote.",
      "properties": {
        "metric-collection-response-time": {
          "description": "API response time in milliseconds when requesting the metrics from the remote.",
          "optional": 1,
          "type": "number"
        },
        "time": {
          "description": "Timestamp (UNIX epoch)",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": null,
  "requestSample": "curl -k -X GET -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/remotes/remote/<id>/rrddata?cf=MAX&timeframe=hour'"
}

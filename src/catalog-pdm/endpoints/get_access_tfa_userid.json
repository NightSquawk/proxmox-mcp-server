{
  "operationId": "get_access_tfa_userid",
  "surface": "pdm",
  "resource": "access",
  "category": "Access & Auth",
  "name": "{userid}",
  "method": "GET",
  "path": "/access/tfa/{userid}",
  "description": "Add a TOTP secret to the user.",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "userid",
      "type": "string",
      "required": true,
      "description": "User ID",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "/^(?:[^\\s:/[:cntrl:]]+)@(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    }
  ],
  "params": [],
  "returns": {
    "description": "A list of TFA entries for a user.",
    "items": {
      "additionalProperties": false,
      "description": "A TFA entry for a user.",
      "properties": {
        "created": {
          "description": "Creation time of this entry as unix epoch.",
          "type": "integer"
        },
        "description": {
          "description": "User chosen description for this entry.",
          "type": "string"
        },
        "enable": {
          "description": "Whether this TFA entry is currently enabled.",
          "type": "boolean"
        },
        "id": {
          "description": "The id used to reference this entry.",
          "type": "string"
        },
        "type": {
          "description": "A TFA entry type.",
          "enum": [
            "totp",
            "u2f",
            "webauthn",
            "recovery",
            "yubico"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": {
    "or": [
      {
        "check": {
          "partial": false,
          "path": [
            "access",
            "users"
          ],
          "privs": [
            "Access.Modify"
          ]
        }
      },
      {
        "userParam": "userid"
      }
    ]
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/access/tfa/<userid>'"
}

{
  "operationId": "get_ceph_clusters_cluster_mon",
  "surface": "pdm",
  "resource": "ceph",
  "category": "Ceph",
  "name": "mon",
  "method": "GET",
  "path": "/ceph/clusters/{cluster}/mon",
  "description": "List the cluster's Ceph monitors.",
  "writeOperation": false,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "query",
  "pathParams": [
    {
      "name": "cluster",
      "type": "string",
      "required": true,
      "description": "Ceph cluster identifier (fsid).",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    }
  ],
  "params": [],
  "returns": {
    "description": "Ceph monitors of the cluster.",
    "items": {
      "additionalProperties": false,
      "description": "Object.",
      "properties": {
        "addr": {
          "description": "Address as advertised by the monitor; Ceph-formatted (typically\n'IP:PORT/NONCE', possibly as a messenger-v2 vector depending on Ceph\nversion and ceph.conf shape).",
          "optional": 1,
          "type": "string"
        },
        "ceph_version": {
          "description": "Full Ceph version string of the monitor daemon.",
          "optional": 1,
          "type": "string"
        },
        "ceph_version_short": {
          "description": "Short Ceph version string of the monitor daemon (e.g. '19.2.0').",
          "optional": 1,
          "type": "string"
        },
        "direxists": {
          "default": false,
          "description": "Set when the monitor's data directory exists on this node.",
          "optional": 1,
          "type": "boolean"
        },
        "host": {
          "description": "Host the monitor runs on.",
          "optional": 1,
          "type": "string"
        },
        "name": {
          "description": "Monitor id (typically the hostname).",
          "type": "string"
        },
        "quorum": {
          "default": false,
          "description": "Set when the monitor is part of the current quorum.",
          "optional": 1,
          "type": "boolean"
        },
        "rank": {
          "description": "Rank of the monitor within the mon map.",
          "optional": 1,
          "type": "integer"
        },
        "service": {
          "default": false,
          "description": "Set if a ceph-mon@<id> systemd unit is enabled on the hosting node;\nabsent otherwise.",
          "optional": 1,
          "type": "boolean"
        },
        "state": {
          "description": "Run state of the monitor: 'running' (in quorum), 'stopped' (systemd unit\nconfigured but daemon not visible to the cluster), or 'unknown' (no\nrados access).",
          "optional": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "type": "array"
  },
  "permissions": {
    "user": "all"
  },
  "requestSample": "curl -k -X GET -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' 'https://PDM_HOST:8443/api2/json/ceph/clusters/<cluster>/mon'"
}

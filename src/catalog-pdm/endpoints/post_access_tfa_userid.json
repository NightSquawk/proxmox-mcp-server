{
  "operationId": "post_access_tfa_userid",
  "surface": "pdm",
  "resource": "access",
  "category": "Access & Auth",
  "name": "{userid}",
  "method": "POST",
  "path": "/access/tfa/{userid}",
  "description": "Add a TFA entry to the user.",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "userid",
      "type": "string",
      "required": true,
      "description": "User ID",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "/^(?:[^\\s:/[:cntrl:]]+)@(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    }
  ],
  "params": [
    {
      "name": "challenge",
      "type": "string",
      "required": false,
      "description": "When responding to a u2f challenge: the original challenge string"
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "description": "A description to distinguish multiple entries from one another",
      "maxLength": 255
    },
    {
      "name": "password",
      "type": "string",
      "required": false,
      "description": "Password.",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "/^[[:^cntrl:]]*$/"
    },
    {
      "name": "totp",
      "type": "string",
      "required": false,
      "description": "A totp URI."
    },
    {
      "name": "type",
      "type": "string",
      "required": true,
      "description": "A TFA entry type.",
      "enum": [
        "totp",
        "u2f",
        "webauthn",
        "recovery",
        "yubico"
      ]
    },
    {
      "name": "value",
      "type": "string",
      "required": false,
      "description": "The current value for the provided totp URI, or a Webauthn/U2F challenge response"
    }
  ],
  "returns": {
    "additionalProperties": false,
    "description": "The result returned when adding TFA entries to a user.",
    "properties": {
      "challenge": {
        "description": "When adding u2f entries, this contains a challenge the user must respond to in order to\nfinish the registration.",
        "optional": 1,
        "type": "string"
      },
      "id": {
        "description": "The id if a newly added TFA entry.",
        "optional": 1,
        "type": "string"
      },
      "recovery": {
        "description": "A list of recovery codes as integers.",
        "items": {
          "description": "A one-time usable recovery code entry.",
          "type": "integer"
        },
        "type": "array"
      }
    },
    "type": "object"
  },
  "permissions": {
    "or": [
      {
        "check": {
          "partial": false,
          "path": [
            "access",
            "users"
          ],
          "privs": [
            "Access.Modify"
          ]
        }
      },
      {
        "userParam": "userid"
      }
    ]
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{\"type\":\"totp\"}' 'https://PDM_HOST:8443/api2/json/access/tfa/<userid>'"
}

{
  "operationId": "post_pve_remotes_remote_nodes_node_apt_update",
  "surface": "pdm",
  "resource": "pve",
  "category": "PVE Remotes",
  "name": "update",
  "method": "POST",
  "path": "/pve/remotes/{remote}/nodes/{node}/apt/update",
  "description": "Update the APT database of a remote PVE node.",
  "writeOperation": true,
  "destructive": false,
  "protected": false,
  "allowtoken": true,
  "paramLocation": "body",
  "pathParams": [
    {
      "name": "remote",
      "type": "string",
      "required": true,
      "description": "Remote ID.",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "/^(?:[A-Za-z0-9_][A-Za-z0-9._\\-]*)$/"
    },
    {
      "name": "node",
      "type": "string",
      "required": true,
      "description": "Node name (or 'localhost')",
      "pattern": "/^(?:[a-zA-Z0-9](?:[a-zA-Z0-9\\-]*[a-zA-Z0-9])?)$/"
    }
  ],
  "params": [],
  "returns": {
    "description": "A remote UPID",
    "minLength": 42,
    "type": "string"
  },
  "permissions": {
    "check": {
      "partial": false,
      "path": [
        "resource",
        "{remote}",
        "node",
        "{node}",
        "system"
      ],
      "privs": [
        "Resource.Modify"
      ]
    }
  },
  "requestSample": "curl -k -X POST -H 'Authorization: PDMAPIToken=USER@REALM!TOKENID=SECRET' -H 'Content-Type: application/json' \\\n  -d '{}' 'https://PDM_HOST:8443/api2/json/pve/remotes/<remote>/nodes/<node>/apt/update'"
}

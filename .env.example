# Proxmox MCP Server: environment configuration.
# Configure one or both surfaces. Tools for an unconfigured surface error only
# at call time (the catalog still lists/describes every endpoint regardless).

# ── Proxmox VE ────────────────────────────────────────────────────────────────
# Host:port is assembled as https://<PVE_HOST>:8006/api2/json unless PVE_BASE_URL is set.
PVE_HOST=pve.example.com
# PVE_BASE_URL=https://pve.example.com:8006/api2/json   # overrides PVE_HOST if set
PVE_TOKEN_ID=root@pam!mcp
PVE_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Proxmox uses self-signed certs by default. Set false to skip TLS verification.
PVE_TLS_REJECT_UNAUTHORIZED=false
# Auth header is `PVEAPIToken=<ID>=<SECRET>`. Override scheme/separator if needed:
# PVE_AUTH_SCHEME=PVEAPIToken
# PVE_AUTH_SEP==

# ── Proxmox Datacenter Manager ────────────────────────────────────────────────
# Host:port is assembled as https://<PDM_HOST>:8443/api2/json unless PDM_BASE_URL is set.
PDM_HOST=pdm.example.com
# PDM_BASE_URL=https://pdm.example.com:8443/api2/json
PDM_TOKEN_ID=root@pam!mcp
PDM_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PDM_TLS_REJECT_UNAUTHORIZED=false
# PDM's token scheme/separator may differ from PVE. Adjust if auth fails:
# PDM_AUTH_SCHEME=PDMAPIToken
# PDM_AUTH_SEP==

# ── Write gate (read-only by default) ─────────────────────────────────────────
# Writes (POST/PUT/DELETE) are BLOCKED unless explicitly enabled.
# Enable for all surfaces:
# PROXMOX_ALLOW_WRITES=true
# Or per-surface:
# PVE_ALLOW_WRITES=true
# PDM_ALLOW_WRITES=true
# Destructive ops (delete/stop/reset/migrate/...) additionally require confirm:true on the call.
